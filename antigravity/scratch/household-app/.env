# ==========================================
# HomeSphere Household Management Environment
# ==========================================

# Server Port
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=homesphere_super_secure_jwt_secret_key_2026

# Optional: Google Gemini AI API Key
GEMINI_API_KEY=

# ==========================================
# REAL EMAIL NOTIFICATION CONFIGURATION
# ==========================================
# Choose ONE of the following options:

# OPTION 1: GMAIL (Recommended & Easiest)
# Generate an App Password at: https://myaccount.google.com/apppasswords
# MAIL_PROVIDER=gmail
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM="HomeSphere Notifications" <your_email@gmail.com>

# OPTION 2: CUSTOM SMTP (Brevo, SendGrid, Mailgun, AWS SES, Hostinger, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="HomeSphere" <your_email@domain.com>

# OPTION 3: RESEND
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_123456789
# SMTP_FROM=onboarding@resend.dev

# Reminder Evaluation Interval (in minutes)
REMINDER_INTERVAL_MINUTES=60
