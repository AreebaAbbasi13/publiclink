{"step_index":277,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-02T13:59:56Z","thinking":"Expense summary component is the next step. It requires comprehensive data aggregation, month selection for analysis, and comparison with the prior month. The design will include aggregate metrics, pie charts for category breakdowns (overall and month-over-month), and detailed tables for category analysis. It must also have a print functionality.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"@'\nimport React, { useState, useEffect, useCallback } from 'react';\nimport { \n  FileText, \n  Printer, \n  Calendar, \n  TrendingUp, \n  TrendingDown, \n  ArrowRight,\n  PieChart as PieIcon,\n  Receipt,\n  CreditCard,\n  Package,\n  CheckCircle2\n} from 'lucide-react';\nimport { useAuth } from '../context/AuthContext';\nimport PieChart from './Visualizations/PieChart';\n\nexport default function ExpenseSummary() {\n  const { authFetch, user } = useAuth();\n  const currency = user?.currency || '$';\n\n  const [month, setMonth] = useState(new Date().toISOString().slice(0, 7));\n  const [summaryData, setSummaryData] = useState(null);\n  const [loading, setLoading] = useState(true);\n\n  const fetchSummary = useCallback(async () => {\n    setLoading(true);\n    try {\n      const res = await authFetch(`/api/summary/complete?month=${month}`);\n      if (res.ok) {\n        setSummaryData(await res.json());\n      }\n    } catch (err) {\n      console.error('Failed to load complete summary:', err);\n    } finally {\n      setLoading(false);\n    }\n  }, [authFetch, month]);\n\n  useEffect(() => {\n    fetchSummary();\n  }, [fetchSummary]);\n\n  const current = summaryData?.current;\n  const previous = summaryData?.previous;\n  const categoryBreakdown = summaryData?.categoryBreakdown || [];\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const diffAmount = (current?.totalSpent || 0) - (previous?.totalSpent || 0);\n  const diffPct = previous?.totalSpent > 0 ? ((diffAmount / previous.totalSpent) * 100).toFixed(1) : null;\n\n  return (\n    <div className=\"space-y-8 animate-fade-in print:p-0\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 print:hidden\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight\">\n            Complete Expense Summary\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1\">\n            Comprehensive financial audit, category breakdowns, and month-over-month comparison.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <input\n            type=\"month\"\n            value={month}\n            onChange={(e) => setMonth(e.target.value)}\n            className=\"px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-sky-500\"\n          />\n          <button\n            onClick={handlePrint}\n            className=\"flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors shadow-xs\"\n          >\n            <Printer className=\"w-4 h-4\" />\n            <span>Print Report</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Printable Title Banner */}\n      <div className=\"hidden print:block text-center border-b pb-4 mb-6\">\n        <h1 className=\"text-2xl font-bold\">HomeSphere Household Ledger Summary</h1>\n        <p className=\"text-sm text-slate-600\">Period: {month} • Generated for {user?.name}</p>\n      </div>\n\n      {/* Overview Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <div className=\"p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n            Total Monthly Outflow\n          </span>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-slate-900 dark:text-white\">\n              {currency}{current?.totalSpent ? current.totalSpent.toFixed(2) : '0.00'}\n            </span>\n          </div>\n          {diffPct !== null && (\n            <p className={`text-xs font-semibold mt-1.5 flex items-center gap-1 ${diffAmount > 0 ? 'text-rose-500' : 'text-emerald-500'}`}>\n              {diffAmount > 0 ? <TrendingUp className=\"w-3.5 h-3.5\" /> : <TrendingDown className=\"w-3.5 h-3.5\" />}\n              <span>{Math.abs(Number(diffPct))}% vs previous month</span>\n            </p>\n          )}\n        </div>\n\n        <div className=\"p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n            Paid Bills & Rent\n          </span>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-sky-600 dark:text-sky-400\">\n              {currency}{current?.paidBills ? current.paidBills.toFixed(2) : '0.00'}\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n            {current?.billsCount || 0} bill record(s)\n          </p>\n        </div>\n\n        <div className=\"p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n            Daily Expenses\n          </span>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-emerald-600 dark:text-emerald-400\">\n              {currency}{current?.dailyExpenses ? current.dailyExpenses.toFixed(2) : '0.00'}\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n            {current?.expensesCount || 0} expense transaction(s)\n          </p>\n        </div>\n\n        <div className=\"p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n            Pantry Purchases\n          </span>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-amber-600 dark:text-amber-400\">\n              {currency}{current?.pantrySpending ? current.pantrySpending.toFixed(2) : '0.00'}\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n            {current?.pantryPurchasesCount || 0} market purchase(s)\n          </p>\n        </div>\n      </div>\n\n      {/* Primary Category Distribution Pie Chart */}\n      <div className=\"p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs flex flex-col justify-center\">\n        <PieChart\n          data={categoryBreakdown}\n          currency={currency}\n          title={`All Expenditures by Category (${month})`}\n          subtitle=\"Consolidated distribution across bills, daily expenses, and pantry restocks\"\n          size={260}\n        />\n      </div>\n\n      {/* Month-over-Month Comparison Pie Charts Section */}\n      <div className=\"p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs space-y-6\">\n        <div>\n          <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            Month-over-Month Comparison\n          </h3>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\">\n            Compare spending distribution between {summaryData?.currentMonth} and {summaryData?.previousMonth}.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8 pt-2\">\n          {/* Current Month Pie */}\n          <div className=\"p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/40 flex flex-col items-center\">\n            <h4 className=\"text-sm font-bold text-slate-800 dark:text-slate-200 mb-2\">\n              Current Month: {summaryData?.currentMonth} ({currency}{current?.totalSpent ? current.totalSpent.toFixed(2) : '0.00'})\n            </h4>\n            <PieChart\n              data={current?.pie || []}\n              currency={currency}\n              title=\"\"\n              size={200}\n            />\n          </div>\n\n          {/* Previous Month Pie */}\n          <div className=\"p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/40 flex flex-col items-center\">\n            <h4 className=\"text-sm font-bold text-slate-800 dark:text-slate-200 mb-2\">\n              Previous Month: {summaryData?.previousMonth} ({currency}{previous?.totalSpent ? previous.totalSpent.toFixed(2) : '0.00'})\n            </h4>\n            <PieChart\n              data={previous?.pie || []}\n              currency={currency}\n              title=\"\"\n              size={200}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Comprehensive Category Table */}\n      <div className=\"rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden\">\n        <div className=\"p-6 border-b border-slate-100 dark:border-slate-800\">\n          <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            Category Breakdown Ledger\n          </h3>\n        </div>\n\n        {categoryBreakdown.length === 0 ? (\n          <div className=\"p-8 text-center text-xs text-slate-400\">\n            No expenses recorded for this period.\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n                  <th className=\"py-3.5 px-6\">Expense Category</th>\n                  <th className=\"py-3.5 px-6\">Total Spent</th>\n                  <th className=\"py-3.5 px-6\">Percentage of Total</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\">\n                {categoryBreakdown.map((cat, idx) => (\n                  <tr key={idx} className=\"hover:bg-slate-50/50 dark:hover:bg-slate-800/50\">\n                    <td className=\"py-3.5 px-6 font-bold text-slate-900 dark:text-white\">\n                      {cat.label}\n                    </td>\n                    <td className=\"py-3.5 px-6 font-extrabold text-slate-900 dark:text-white\">\n                      {currency}{cat.value.toFixed(2)}\n                    </td>\n                    <td className=\"py-3.5 px-6\">\n                      <div className=\"flex items-center gap-3\">\n                        <div className=\"w-24 h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden\">\n                          <div\n                            className=\"h-full bg-sky-500 rounded-full\"\n                            style={{ width: `${cat.percentage}%` }}\n                          />\n                        </div>\n                        <span className=\"font-semibold text-slate-600 dark:text-slate-400\">\n                          {cat.percentage}%\n                        </span>\n                      </div>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n'@ | Out-File -FilePath \"client\\src\\components\\ExpenseSummary.jsx\" -Encoding utf8","Cwd":"C:\\Users\\HP\\.gemini\\antigravity\\scratch\\household-app","WaitMsBeforeAsync":5000,"toolAction":"Writing ExpenseSummary component","toolSummary":"Write ExpenseSummary.jsx"}}]}
