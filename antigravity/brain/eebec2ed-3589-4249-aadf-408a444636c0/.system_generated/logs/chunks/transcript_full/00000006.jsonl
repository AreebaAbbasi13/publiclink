{"step_index":323,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-02T15:22:46Z","content":"Created At: 2026-09-02T08:22:46-07:00\nCompleted At: 2026-09-02T08:22:46-07:00\nFile Path: `file:///C:/Users/HP/.gemini/antigravity/scratch/household-app/server/services/reminderEngine.js`\nTotal Lines: 179\nTotal Bytes: 7144\nShowing lines 1 to 179\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const db = require('../db/database');\n2: \n3: /**\n4:  * Calculates accurate bill reminder statuses based on due date:\n5:  * - 15 days left\n6:  * - 10 days left\n7:  * - 7 days left\n8:  * - 4 days left\n9:  * - 3 days left\n10:  * - 1 day left\n11:  * - Some hours left (today)\n12:  * - Overdue\n13:  */\n14: function evaluateUserReminders(userId) {\n15:   const today = new Date();\n16:   const user = db.prepare('SELECT currency FROM users WHERE id = ?').get(userId);\n17:   const currency = user ? user.currency : '$';\n18: \n19:   // 1. Fetch pending & overdue bills\n20:   const bills = db.prepare('SELECT * FROM bills WHERE user_id = ?').all(userId);\n21:   const reminders = [];\n22: \n23:   for (const bill of bills) {\n24:     if (bill.status === 'Paid') continue;\n25: \n26:     const dueDateObj = new Date(bill.due_date + 'T23:59:59');\n27:     const diffMs = dueDateObj.getTime() - today.getTime();\n28:     const diffHours = diffMs / (1000 * 60 * 60);\n29:     const diffDays = Math.ceil(diffHours / 24);\n30: \n31:     let reminderLevel = null;\n32:     let reminderTitle = '';\n33:     let reminderMessage = '';\n34:     let urgency = 'info'; // 'info' | 'warning' | 'danger'\n35: \n36:     if (diffMs < 0) {\n37:       // Overdue\n38:       if (bill.status !== 'Overdue') {\n39:         db.prepare(\"UPDATE bills SET status = 'Overdue' WHERE id = ?\").run(bill.id);\n40:         bill.status = 'Overdue';\n41:       }\n42:       const daysOverdue = Math.abs(diffDays);\n43:       reminderLevel = 'overdue';\n44:       urgency = 'danger';\n45:       reminderTitle = `Overdue Bill: ${bill.name}`;\n46:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is overdue by ${daysOverdue === 0 ? '1 day' : daysOverdue + ' days'} (Due: ${bill.due_date}).`;\n47:     } else if (diffHours <= 24) {\n48:       // Some hours left / Due Today\n49:       reminderLevel = 'hours';\n50:       urgency = 'danger';\n51:       const hoursRemaining = Math.max(1, Math.round(diffHours));\n52:       reminderTitle = `Due Today (${hoursRemaining}h left): ${bill.name}`;\n53:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is due today! ${hoursRemaining} hours remaining.`;\n54:     } else if (diffDays === 1) {\n55:       // 1 day left\n56:       reminderLevel = '1_day';\n57:       urgency = 'danger';\n58:       reminderTitle = `1 Day Left: ${bill.name}`;\n59:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is due tomorrow (${bill.due_date}).`;\n60:     } else if (diffDays === 3) {\n61:       // 3 days left\n62:       reminderLevel = '3_days';\n63:       urgency = 'warning';\n64:       reminderTitle = `3 Days Left: ${bill.name}`;\n65:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is due in 3 days (${bill.due_date}).`;\n66:     } else if (diffDays === 4) {\n67:       // 4 days left\n68:       reminderLevel = '4_days';\n69:       urgency = 'warning';\n70:       reminderTitle = `4 Days Left: ${bill.name}`;\n71:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is due in 4 days (${bill.due_date}).`;\n72:     } else if (diffDays >= 6 && diffDays <= 7) {\n73:       // 7 days left\n74:       reminderLevel = '7_days';\n75:       urgency = 'warning';\n76:       reminderTitle = `7 Days Left: ${bill.name}`;\n77:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is due in ${diffDays} days (${bill.due_date}).`;\n78:     } else if (diffDays >= 9 && diffDays <= 10) {\n79:       // 10 days left\n80:       reminderLevel = '10_days';\n81:       urgency = 'info';\n82:       reminderTitle = `10 Days Left: ${bill.name}`;\n83:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is due in ${diffDays} days (${bill.due_date}).`;\n84:     } else if (diffDays >= 14 && diffDays <= 15) {\n85:       // 15 days left\n86:       reminderLevel = '15_days';\n87:       urgency = 'info';\n88:       reminderTitle = `15 Days Left: ${bill.name}`;\n89:       reminderMessage = `${bill.name} (${currency}${bill.amount.toFixed(2)}) is due in ${diffDays} days (${bill.due_date}).`;\n90:     }\n91: \n92:     if (reminderLevel) {\n93:       reminders.push({\n94:         id: `bill-${bill.id}-${reminderLevel}`,\n95:         type: 'bill_reminder',\n96:         category: bill.category,\n97:         billId: bill.id,\n98:         level: reminderLevel,\n99:         urgency,\n100:         title: reminderTitle,\n101:         message: reminderMessage,\n102:         amount: bill.amount,\n103:         dueDate: bill.due_date,\n104:         createdAt: bill.created_at\n105:       });\n106:     }\n107:   }\n108: \n109:   // 2. Evaluate Pantry Low Stock\n110:   const pantryItems = db.prepare('SELECT * FROM pantry_items WHERE user_id = ?').all(userId);\n111:   for (const item of pantryItems) {\n112:     if (item.quantity <= item.min_threshold) {\n113:       reminders.push({\n114:         id: `pantry-${item.id}-low`,\n115:         type: 'pantry_low',\n116:         category: 'Pantry',\n117:         itemId: item.id,\n118:         urgency: item.quantity === 0 ? 'danger' : 'warning',\n119:         title: item.quantity === 0 ? `Out of Stock: ${item.name}` : `Running Low: ${item.name}`,\n120:         message: `${item.name} has ${item.quantity} ${item.unit} left (Threshold: ${item.min_threshold} ${item.unit}). Added to Suggested Shopping List.`,\n121:         createdAt: item.updated_at\n122:       });\n123:     }\n124:   }\n125: \n126:   // 3. Evaluate Budget Status\n127:   const currentMonthYear = today.toISOString().slice(0, 7);\n128:   const budgetRecord = db.prepare('SELECT monthly_limit FROM budgets WHERE user_id = ? AND month_year = ?').get(userId, currentMonthYear);\n129:   \n130:   if (budgetRecord && budgetRecord.monthly_limit > 0) {\n131:     const monthlyLimit = budgetRecord.monthly_limit;\n132:     \n133:     const billsPaid = db.prepare(`\n134:       SELECT COALESCE(SUM(amount), 0) as total \n135:       FROM bills \n136:       WHERE user_id = ? AND status = 'Paid' AND (due_date LIKE ? OR payment_date LIKE ?)\n137:     `).get(userId, `${currentMonthYear}%`, `${currentMonthYear}%`).total;\n138: \n139:     const expensesTotal = db.prepare(`\n140:       SELECT COALESCE(SUM(amount), 0) as total \n141:       FROM expenses \n142:       WHERE user_id = ? AND expense_date LIKE ?\n143:     `).get(userId, `${currentMonthYear}%`).total;\n144: \n145:     const pantryTotal = db.prepare(`\n146:       SELECT COALESCE(SUM(total_cost), 0) as total \n147:       FROM pantry_purchases \n148:       WHERE user_id = ? AND purchase_date LIKE ?\n149:     `).get(userId, `${currentMonthYear}%`).total;\n150: \n151:     const totalSpent = billsPaid + expensesTotal + pantryTotal;\n152:     const spentPercentage = (totalSpent / monthlyLimit) * 100;\n153: \n154:     if (totalSpent >= monthlyLimit) {\n155:       reminders.push({\n156:         id: `budget-${currentMonthYear}-exceeded`,\n157:         type: 'saving_alert',\n158:         urgency: 'danger',\n159:         title: 'Saving Alert: Monthly Budget Exceeded',\n160:         message: `You have spent ${currency}${totalSpent.toFixed(2)}, exceeding your ${currency}${monthlyLimit.toFixed(2)} monthly budget by ${currency}${(totalSpent - monthlyLimit).toFixed(2)}. Consider reviewing discretionary expenses.`,\n161:         createdAt: new Date().toISOString()\n162:       });\n163:     } else if (spentPercentage >= 80) {\n164:       reminders.push({\n165:         id: `budget-${currentMonthYear}-low`,\n166:         type: 'budget_alert',\n167:         urgency: 'warning',\n168:         title: `Budget Running Low (${spentPercentage.toFixed(0)}% Used)`,\n169:         message: `You have spent ${currency}${totalSpent.toFixed(2)} of your ${currency}${monthlyLimit.toFixed(2)} budget. Only ${currency}${(monthlyLimit - totalSpent).toFixed(2)} remaining for ${currentMonthYear}.`,\n170:         createdAt: new Date().toISOString()\n171:       });\n172:     }\n173:   }\n174: \n175:   return reminders;\n176: }\n177: \n178: module.exports = { evaluateUserReminders };\r\n179: \nThe above content shows the entire, complete file contents of the requested file.\n"}
