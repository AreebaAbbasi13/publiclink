atus.toLowerCase() === statusFilter.toLowerCase();\n149:     const matchesCategory = categoryFilter === 'All' || bill.category === categoryFilter;\n150:     const matchesSearch = searchQuery === '' || \n151:       bill.name.toLowerCase().includes(searchQuery.toLowerCase()) || \n152:       bill.category.toLowerCase().includes(searchQuery.toLowerCase()) ||\n153:       (bill.notes && bill.notes.toLowerCase().includes(searchQuery.toLowerCase()));\n154:     return matchesStatus && matchesCategory && matchesSearch;\n155:   });\n156: \n157:   return (\n158:     <div className=\"space-y-8 animate-fade-in\">\n159:       {/* Header */}\n160:       <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n161:         <div>\n162:           <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight\">\n163:             Bills & Rent Management\n164:           </h1>\n165:           <p className=\"text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1\">\n166:             Add, track, and pay rent, utilities, education, household fees with automatic 7-tier reminders.\n167:           </p>\n168:         </div>\n169: \n170:         <div className=\"flex items-center gap-3\">\n171:           <input\n172:             type=\"month\"\n173:             value={monthFilter}\n174:             onChange={(e) => setMonthFilter(e.target.value)}\n175:             className=\"px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-sky-500\"\n176:           />\n177:           <button\n178:             onClick={() => {\n179:               setEditingBill(null);\n180:               setIsAddModalOpen(true);\n181:             }}\n182:             className=\"flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-sky-600 hover:bg-sky-500 text-white transition-colors shadow-sm\"\n183:       