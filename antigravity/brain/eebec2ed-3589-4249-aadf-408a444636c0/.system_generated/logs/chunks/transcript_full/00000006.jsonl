en, setIsExpenseModalOpen] = useState(false);\n39:   const [isPantryModalOpen, setIsPantryModalOpen] = useState(false);\n40:   const [isMarketModalOpen, setIsMarketModalOpen] = useState(false);\n41:   const [isBudgetModalOpen, setIsBudgetModalOpen] = useState(false);\n42: \n43:   const fetchDashboardData = useCallback(async () => {\n44:     setLoading(true);\n45:     try {\n46:       const currentMonth = new Date().toISOString().slice(0, 7);\n47: \n48:       const [budgetRes, billsRes, expRes, pantryRes, notifRes] = await Promise.all([\n49:         authFetch(`/api/budget?month=${currentMonth}`),\n50:         authFetch(`/api/bills?month=${currentMonth}`),\n51:         authFetch(`/api/expenses?month=${currentMonth}`),\n52:         authFetch('/api/pantry'),\n53:         authFetch('/api/notifications')\n54:       ]);\n55: \n56:       if (budgetRes.ok) setBudgetData(await budgetRes.json());\n57:       if (billsRes.ok) setBills(await billsRes.json());\n58:       if (expRes.ok) {\n59:         const expData = await expRes.json();\n60:         setExpenses(expData.expenses || []);\n61:       }\n62:       if (pantryRes.ok) setPantryData(await pantryRes.json());\n63:       if (notifRes.ok) {\n64:         const notifData = await notifRes.json();\n65:         setNotifications(notifData.notifications || []);\n66:       }\n67:     } catch (err) {\n68:       console.error('Failed to load dashboard data:', err);\n69:     } finally {\n70:       setLoading(false);\n71:     }\n72:   }, [authFetch]);\n73: \n74:   useEffect(() => {\n75:     fetchDashboardData();\n76:   }, [fetchDashboardData]);\n77: \n78:   const unpaidBills = bills.filter(b => b.status !== 'Paid');\n79:   const overdueBills = bills.filter(b => b.status === 'Overdue');\n80:   const totalUnpaidAmount = unpaidBills.reduce((acc, b) => acc + b.amount, 0);\n81: \n82:   const lowStockPantryItems = pantryData?.lowStockItems || [];\n83:   const urgentAlerts = notifications.filter(n => n.urgency === 'danger' || n.urgency === 'warning');\n84: \n85:   return (\n86:     <div className=\"space-y-8 animate-fade-in\">\n87:       {/* Top Welcome & Actions Header */}\n88:       <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n89:         <div>\n90:           <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight\">\n91:             Household Overview\n92:           </h1>\n93:           <p className=\"text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1\">\n94:             Real-time financial status, bill reminders, and pantry tracker for {new Date().toLocaleString('default', { month: 'long', year: 'numeric' })}.\n95:           </p>\n96:         </div>\n97: \n98:         <div className=\"flex items-center gap-2.5 flex-wrap\">\n99:           <button\n100:             onClick={fetchDashboardData}\n101:             title=\"Refresh Dashboard\"\n102:             className=\"p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n103:           >\n104:             <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin' : ''}`} />\n105:           </button>\n106: \n107:           <button\n108:             onClick={() => setIsExpenseModalOpen(true)}\n109:             className=\"flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors shadow-xs\"\n110:           >\n111:             <Plus className=\"w-4 h-4\" />\n112:             <span>Add Expense</span>\n113:           </button>\n114: \n115:           <button\n116:             onClick={() => setIsBillModalOpen(true)}\n117:             className=\"flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-sky-600 hover:bg-sky-500 text-white transition-colors shadow-xs\"\n118:           >\n119:             <Plus className=\"w-4 h-4\" />\n120:             <span>Add Bill</span>\n121:           </button>\n122:         </div>\n123:       </div>\n124: \n125:       {/* Urgent Alerts Banner (if any) */}\n126:       {urgentAlerts.length > 0 && (\n127:         <div className=\"space-y-2\">\n128:           {urgentAlerts.slice(0, 2).map((alert) => (\n129:             <div\n130:               key={alert.id}\n131:               className={`p-4 rounded-2xl border flex items-center justify-between gap-3 ${\n132:                 alert.urgency === 'danger'\n133:                   ? 'bg-rose-50/80 dark:bg-rose-950/40 border-rose-200 dark:border-rose-900/60 text-rose-900 dark:text-rose-100'\n134:                   : 'bg-amber-50/80 dark:bg-amber-950/40 border-amber-200 dark:border-amber-900/60 text-amber-900 dark:text-amber-100'\n135:               }`}\n136:             >\n137:               <div className=\"flex items-center gap-3 min-w-0\">\n138:                 <AlertTriangle className={`w-5 h-5 shrink-0 ${alert.urgency === 'danger' ? 'text-rose-600 dark:text-rose-400' : 'text-amber-600 dark:text-amber-400'}`} />\n139:                 <div className=\"min-w-0\">\n140:                   <p className=\"text-xs font-bold truncate\">{alert.title}</p>\n141:                   <p className=\"text-[11px] opacity-90 truncate\">{alert.message}</p>\n142:                 </div>\n143:               </div>\n144:               <button\n145:                 onClick={() => {\n146:                   if (alert.type === 'bill_reminder') setActiveTab('bills');\n147:                   else if (alert.type === 'pantry_low') setActiveTab('pantry');\n148:                   else setActiveTab('budget');\n149:                 }}\n150:                 className=\"text-xs font-bold underline shrink-0 hover:opacity-80\"\n151:               >\n152:                 Review →\n153:               </button>\n154:             </div>\n155:           ))}\n156:         </div>\n157:       )}\n158: \n159:       {/* 4 Main KPI Cards */}\n160:       <div className=\"grid grid-cols-1 sm:grid-cols-2 lg