     <button\n166:               key={cat}\n167:               onClick={() => setCategoryFilter(cat)}\n168:               className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-colors ${\n169:                 categoryFilter === cat\n170:                   ? 'bg-emerald-600 text-white shadow-xs'\n171:                   : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'\n172:               }`}\n173:             >\n174:               {cat}\n175:             </button>\n176:           ))}\n177:         </div>\n178: \n179:         {/* Search Bar */}\n180:         <div className=\"relative w-full sm:w-72\">\n181:           <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n182:           <input\n183:             type=\"text\"\n184:             placeholder=\"Search transactions...\"\n185:             value={searchQuery}\n186:             onChange={(e) => setSearchQuery(e.target.value)}\n187:             className=\"w-full pl-9 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n188:           />\n189:         </div>\n190:       </div>\n191: \n192:       {/* Expenses History Table */}\n193:       <div className=\"rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden\">\n194:         {expenses.length === 0 ? (\n195:           <div className=\"p-12 text-center\">\n196:             <div className=\"w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-400\">\n197:               <CreditCard className=\"w-8 h-8\" />\n198:             </div>\n199:             <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n200:               No expenses found\n201:             </h3>\n202:             <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto mt-1 mb-4\">\n203:               Add your daily food, transit, or utility expenditures to track your household burn rate.\n204:             </p>\n205:             <button\n206:               onClick={() => {\n207:                 setEditingExpense(null);\n208:                 setIsModalOpen(true);\n209:               }}\n210:               className=\"px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 transition-colors shadow-xs\"\n211:             >\n212:               + Add First Expense\n213:             </button>\n214:           </div>\n215:         ) : (\n216:           <div className=\"overflow-x-auto\">\n217:             <table className=\"w-full text-left border-collapse\">\n218:               <thead>\n219:                 <tr className=\"border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n220:                   <th className=\"py-3.5 px-6\">Description</th>\n221:                   <th className=\"py-3.5 px-6\">Category</th>\n222:                   <th className=\"py-3.5 px-6\">Date</th>\n223:                   <th className=\"py-3.5 px-6\">Amount</th>\n224:                   <th className=\"py-3.5 px-6 text-right\">Actions</th>\n225:                 </tr>\n226:               </thead>\n227:               <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\">\n228:                 {expenses.map((exp) => (\n229:                   <tr key={exp.id} className=\"hover:bg-slate-50/50 dark:hover:bg-slate-800/50 transition-colors\">\n230:                     <td className=\"py-4 px-6 font-semibold text-slate-900 dark:text-white\">\n231:                       <div>\n232:                         <p className=\"font-bold\">{exp.title}</p>\n233:                         {exp.notes && (\n234:                           <p className=\"text-[11px] text-slate-400 dark:text-slate-500 mt-0.5\">\n235:                             {exp.notes}\n236:                           </p>\n237:                         )}\n238:                       </div>\n239:                     </td>\n240:                     <td className=\"py-4 px-6\">\n241:                       <span className=\"px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300\">\n242:                         {exp.category}\n243:                       </span>\n244:                     </td>\n245:                     <td className=\"py-4 px-6 text-slate-500 dark:text-slate-400 font-medium\">\n246:                       {exp.expense_date}\n247:                     </td>\n248:                     <td className=\"py-4 px-6 font-black text-slate-900 dark:text-white\">\n249:                       {currency}{exp.amount.toFixed(2)}\n250:                     </td>\n251:                     <td className=\"py-4 px-6 text-right\">\n252:                       <div className=\"flex items-center justify-end gap-1\">\n253:                         <button\n254:                           onClick={() => {\n255:                             setEditingExpense(exp);\n256:                             setIsModalOpen(true);\n257:                           }}\n258:                           title=\"Edit\"\n259:                           className=\"p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n260:                         >\n261:                           <Edit3 className=\"w-4 h-4\" />\n262:                         </button>\n263:                         <button\n264:                           onClick={() => handleDelete(exp.id)}\n265:                           title=\"Delete\"\n266:                           className=\"p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-colors\"\n267:         