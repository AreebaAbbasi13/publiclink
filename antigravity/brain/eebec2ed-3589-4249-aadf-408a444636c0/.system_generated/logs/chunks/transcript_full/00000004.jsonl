tLoading(true);\n    try {\n      if (mode === 'signup') {\n        if (!name.trim()) {\n          error('Please enter your full name.');\n          setLoading(false);\n          return;\n        }\n        await register(name.trim(), email.trim(), password, currency);\n        success('Account created successfully! Welcome to HomeSphere.');\n      } else {\n        await login(email.trim(), password);\n        success('Welcome back!');\n      }\n    } catch (err) {\n      error(err.message || 'Authentication failed');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col justify-between selection:bg-sky-500 selection:text-white transition-colors duration-200\">\n      {/* Top Bar */}\n      <header className=\"w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex items-center justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-600 to-indigo-600 text-white flex items-center justify-center shadow-lg shadow-sky-500/20\">\n            <Home className=\"w-5 h-5\" />\n          </div>\n          <span className=\"text-xl font-extrabold tracking-tight bg-gradient-to-r from-sky-600 via-indigo-600 to-violet-600 bg-clip-text text-transparent dark:from-sky-400 dark:via-indigo-400 dark:to-violet-400\">\n            HomeSphere\n          </span>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={toggleTheme}\n            className=\"p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors\"\n          >\n            {isDark ? <Sun className=\"w-5 h-5 text-amber-400\" /> : <Moon className=\"w-5 h-5 text-slate-600\" />}\n          </button>\n        </div>\n      </header>\n\n      {/* Main Content Hero */}\n      <main className=\"w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        {/* Left Side: Product Showcase */}\n        <div className=\"lg:col-span-7 space-y-8\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full border border-sky-200 dark:border-sky-900/60 bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 text-xs font-semibold\">\n            <Sparkles className=\"w-3.5 h-3.5 text-sky-500\" />\n            <span>Complete Production Household Management OS</span>\n          </div>\n\n          <div className=\"space-y-4\">\n            <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.1]\">\n              Master your household{' '}\n              <span className=\"bg-gradient-to-r from-sky-500 via-indigo-500 to-violet-500 bg-clip-text text-transparent\">\n                finances & pantry\n              </span>{' '}\n              with precision.\n            </h1>\n            <p className=\"text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed\">\n              Track rent, 13 bill types with 7-tier reminders, daily expenses, smart pantry inventory with market restock, budget thresholds, and live AI intelligence.\n            </p>\n          </div>\n\n          {/* Feature Highlights Grid */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n            <div className=\"p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 backdrop-blur-xs flex items-start gap-3.5\">\n              <div className=\"p-2 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 shrink-0\">\n                <Receipt className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h4 className=\"text-sm font-bold text-slate-900 dark:text-white\">Bills & Rent Engine</h4>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\">\n                  15d, 10d, 7d, 4d, 3d, 1d & hours-left due date reminders.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 backdrop-blur-xs flex items-start gap-3.5\">\n              <div className=\"p-2 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 shrink-0\">\n                <Package className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h4 className=\"text-sm font-bold text-slate-900 dark:text-white\">Pantry & Market Restock</h4>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\">\n                  Stock levels, running-low alerts, and suggested shopping lists.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 backdrop-blur-xs flex items-start gap-3.5\">\n              <div className=\"p-2 rounded-xl bg-violet-500/10 text-violet-600 dark:text-violet-400 shrink-0\">\n                <Sparkles className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h4 className=\"text-sm font-bold text-slate-900 dark:text-white\">AI Assistant & Summary</h4>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\">\n                  Intelligent recommendations using real household data.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 backdrop-blur-xs flex items-start gap-3.5\">\n              <div className=\"p-2 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 shrink-0\">\n                <PieIcon className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h4 className=\"text-sm font-bold text-slate-900 dark:text-white\">Strict Pie Visualizations</h4>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\">\n                  Category distributions & month-over-month comparisons.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Side: Auth Card */}\n        <div className=\"lg:col-span-5 w-full\">\n          <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl p-6 sm:p-8 relative\">\n            {/* Tabs */}\n            <div className=\"flex rounded-xl bg-slate-100 dark:bg-slate-800 p-1 mb-6\">\n              <button\n                type=\"button\"\n                onClick={() => setMode('signin')}\n                className={`flex-1 py-2.5 text-xs font-bold rounded-lg transition-all ${\n                  mode === 'signin'\n                    ? 'bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs'\n                    : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'\n                }`}\n              >\n                Sign In\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setMode('signup')}\n                className={`flex-1 py-2.5 text-xs font-bold rounded-lg transition-all ${\n                  mode === 'signup'\n                    ? 'bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs'\n                    : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'\n                }`}\n              >\n                Create Account\n              </button>\n            </div>\n\n            <div className=\"mb-5 text-left\">\n              <h3 className=\"text-xl font-bold text-slate-900 dark:text-white\">\n                {mode === 'signup' ? 'Get Started Free' : 'Sign in to HomeSphere'}\n              </h3>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n                {mode === 'signup'\n                  ? 'Create your isolated household ledger with real persistence.'\n                  : 'Enter your credentials to access your household records.'}\n              </p>\n            </div>\n\n            <form onSubmit={handleSubmit} className=\"space-y-4 text-left\">\n              {mode === 'signup' && (\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                    Your Name\n                  </label>\n                  <div className=\"relative\">\n                    <User className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3.5\" />\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"e.g. Sarah Jenkins\"\n                      value={name}\n                      onChange={(e) => setName(e.target.value)}\n                      className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n                    />\n                  </div>\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                  Email Address\n                </label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3.5\" />\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"you@household.app\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                  Password\n                </label>\n                <div className=\"relative\">\n                  <Lock className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3.5\" />\n                  <input\n                    type=\"password\"\n                    required\n                    minLength={6}\n                    placeholder=\"••••••••\"\n                    value={password}\n                    onChange={(e) => setPassword(e.target.value)}\n                    className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n                  />\n                </div>\n              </div>\n\n              {mode === 'signup' && (\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                    Preferred Currency\n                  </label>\n                  <select\n                    value={currency}\n                    onChange={(e) => setCurrency(e.target.value)}\n                    className=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n                  >\n                    {CURRENCIES.map(c => (\n                      <option key={c.code} value={c.code}>{c.label}</option>\n                    ))}\n                  </select>\n                </div>\n              )}\n\n              <button\n                type=\"submit\"\n                disabled={loading}\n                className=\"w-full mt-2 py-3 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-sky-600 via-indigo-600 to-violet-600 hover:opacity-95 disabled:opacity-50 transition-all shadow-lg shadow-sky-500/20 flex items-center justify-center gap-2\"\n              >\n                {loading ? 'Processing...' : mode === 'signup' ? 'Create Account & Enter' : 'Sign In to HomeSphere'}\n                {!loading && <ArrowRight className=\"w-4 h-4\" />}\n              </button>\n            </form>\n\n            <div className=\"mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400\">\n              <ShieldCheck className=\"w-4 h-4 text-emerald-500\" />\n              <span>Persistent SQLite Database • Zero Dummy Data</span>\n            </div>\n          </div>\n        </div>\n      </main>\n\n      {/* Footer */}\n      <footer className=\"w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-xs text-slate-400 dark:text-slate-600\">\n        HomeSphere — Professional Household Management Application\n      </footer>\n    </div>\n  );\n}\n'@ | Out-File -FilePath \"client\\src\\components\\Welcome.jsx\" -Encoding utf8","Cwd":"C:\\Users\\HP\\.gemini\\antigravity\\scratch\\household-app","WaitMsBeforeAsync":5000,"toolAction":"Writing Welcome component","toolSummary":"Write Welcome.jsx"}}]}
