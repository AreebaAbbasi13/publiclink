{"step_index":270,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-02T13:58:24Z","thinking":"Developing the Pantry component, it will allow adding items with detailed attributes like quantity and cost. Functionality will include tracking stock levels with adjustments, generating alerts for low stock based on thresholds, and managing market purchases to update the pantry and spending records. A dynamic shopping list will also be compiled, suggesting replenishment quantities for low items.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"@'\nimport React, { useState, useEffect, useCallback } from 'react';\nimport { \n  Package, \n  Plus, \n  Minus, \n  ShoppingCart, \n  AlertTriangle, \n  Trash2, \n  RefreshCw, \n  TrendingUp, \n  DollarSign,\n  Tag,\n  CheckCircle2,\n  ArrowRight\n} from 'lucide-react';\nimport { useAuth } from '../context/AuthContext';\nimport { useToast } from './Toast';\nimport AddPantryModal from './Modals/AddPantryModal';\nimport MarketPurchaseModal from './Modals/MarketPurchaseModal';\n\nexport default function Pantry() {\n  const { authFetch, user } = useAuth();\n  const { success, error } = useToast();\n  const currency = user?.currency || '$';\n\n  const [pantryData, setPantryData] = useState(null);\n  const [suggestedList, setSuggestedList] = useState(null);\n  const [spendingData, setSpendingData] = useState(null);\n  const [loading, setLoading] = useState(true);\n\n  // Modals\n  const [isAddModalOpen, setIsAddModalOpen] = useState(false);\n  const [isMarketModalOpen, setIsMarketModalOpen] = useState(false);\n  const [preselectedPurchaseItem, setPreselectedPurchaseItem] = useState(null);\n\n  const fetchPantryData = useCallback(async () => {\n    setLoading(true);\n    try {\n      const [pantryRes, suggestedRes, spendingRes] = await Promise.all([\n        authFetch('/api/pantry'),\n        authFetch('/api/pantry/suggested'),\n        authFetch('/api/pantry/spending')\n      ]);\n\n      if (pantryRes.ok) setPantryData(await pantryRes.json());\n      if (suggestedRes.ok) setSuggestedList(await suggestedRes.json());\n      if (spendingRes.ok) setSpendingData(await spendingRes.json());\n    } catch (err) {\n      console.error('Failed to load pantry data:', err);\n    } finally {\n      setLoading(false);\n    }\n  }, [authFetch]);\n\n  useEffect(() => {\n    fetchPantryData();\n  }, [fetchPantryData]);\n\n  const handleAdjustQuantity = async (item, delta) => {\n    try {\n      const res = await authFetch(`/api/pantry/${item.id}/quantity`, {\n        method: 'PUT',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ delta })\n      });\n      if (!res.ok) throw new Error('Failed to update quantity');\n      fetchPantryData();\n    } catch (err) {\n      error(err.message);\n    }\n  };\n\n  const handleDelete = async (id) => {\n    if (!window.confirm('Remove this item from pantry?')) return;\n    try {\n      const res = await authFetch(`/api/pantry/${id}`, { method: 'DELETE' });\n      if (!res.ok) throw new Error('Failed to delete item');\n      success('Item removed from pantry.');\n      fetchPantryData();\n    } catch (err) {\n      error(err.message);\n    }\n  };\n\n  const handleBuyItem = (item) => {\n    setPreselectedPurchaseItem(item);\n    setIsMarketModalOpen(true);\n  };\n\n  const items = pantryData?.items || [];\n  const lowItems = pantryData?.lowStockItems || [];\n  const suggestions = suggestedList?.suggestions || [];\n  const purchases = spendingData?.purchases || [];\n\n  return (\n    <div className=\"space-y-8 animate-fade-in\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight\">\n            Pantry & Grocery Management\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1\">\n            Track stock levels, monitor running-low items, purchase from market, and generate suggested shopping lists.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2.5 flex-wrap\">\n          <button\n            onClick={() => {\n              setPreselectedPurchaseItem(null);\n              setIsMarketModalOpen(true);\n            }}\n            className=\"flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors shadow-xs\"\n          >\n            <ShoppingCart className=\"w-4 h-4\" />\n            <span>Market Purchase</span>\n          </button>\n\n          <button\n            onClick={() => setIsAddModalOpen(true)}\n            className=\"flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-sky-600 hover:bg-sky-500 text-white transition-colors shadow-xs\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Add Item</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Running-Low Alerts Banner */}\n      {lowItems.length > 0 && (\n        <div className=\"p-5 rounded-3xl border border-amber-300 dark:border-amber-900/60 bg-amber-50/70 dark:bg-amber-950/30 shadow-xs\">\n          <div className=\"flex items-center justify-between gap-3 mb-3\">\n            <div className=\"flex items-center gap-2 text-amber-900 dark:text-amber-200\">\n              <AlertTriangle className=\"w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0\" />\n              <h3 className=\"text-sm font-bold\">\n                Running-Low Alert: {lowItems.length} Staple(s) Below Threshold\n              </h3>\n            </div>\n            <span className=\"text-xs font-bold text-amber-700 dark:text-amber-300\">\n              Restock Recommended\n            </span>\n          </div>\n          <div className=\"flex flex-wrap gap-2\">\n            {lowItems.map((item) => (\n              <div\n                key={item.id}\n                className=\"flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-amber-200 dark:border-amber-800 text-xs shadow-xs\"\n              >\n                <span className=\"font-bold text-slate-800 dark:text-slate-200\">{item.name}</span>\n                <span className=\"text-[11px] font-semibold text-rose-600 dark:text-rose-400\">\n                  {item.quantity} {item.unit} left (Min: {item.min_threshold})\n                </span>\n                <button\n                  onClick={() => handleBuyItem(item)}\n                  className=\"ml-1 text-[10px] font-bold px-2 py-0.5 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white transition-colors\"\n                >\n                  Buy\n                </button>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Top 3 KPI Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div className=\"p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n            Total Pantry Items\n          </span>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-slate-900 dark:text-white\">\n              {items.length}\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n            {lowItems.length} item(s) running low\n          </p>\n        </div>\n\n        <div className=\"p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n            Total Pantry Spending\n          </span>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-slate-900 dark:text-white\">\n              {currency}{spendingData?.totalPantrySpending ? spendingData.totalPantrySpending.toFixed(2) : '0.00'}\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n            Across {purchases.length} recorded market purchases\n          </p>\n        </div>\n\n        <div className=\"p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n          <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n            Suggested Restock Cost\n          </span>\n          <div className=\"mt-2 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-emerald-600 dark:text-emerald-400\">\n              {currency}{suggestedList?.totalEstimatedSpend ? suggestedList.totalEstimatedSpend.toFixed(2) : '0.00'}\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n            For {suggestions.length} items on the Suggested Shopping List\n          </p>\n        </div>\n      </div>\n\n      {/* Suggested Shopping List Section */}\n      <div className=\"p-6 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center\">\n              <ShoppingCart className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n                Suggested Shopping List\n              </h3>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Generated automatically based strictly on low-stock items in your pantry.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {suggestions.length === 0 ? (\n          <div className=\"p-6 text-center text-xs text-slate-400 dark:text-slate-500\">\n            No items currently need restocking. Your pantry is well stocked!\n          </div>\n        ) : (\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\">\n            {suggestions.map((sug) => (\n              <div\n                key={sug.id}\n                className=\"p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 flex items-center justify-between gap-3 text-xs\"\n              >\n                <div>\n                  <h4 className=\"font-bold text-slate-900 dark:text-white\">\n                    {sug.name}\n                  </h4>\n                  <p className=\"text-slate-500 dark:text-slate-400 mt-0.5\">\n                    Need: <strong className=\"text-slate-800 dark:text-slate-200\">+{sug.suggestedReplenishQuantity} {sug.unit}</strong>\n                  </p>\n                  {sug.estimatedCost > 0 && (\n                    <p className=\"text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5\">\n                      Est. {currency}{sug.estimatedCost.toFixed(2)}\n                    </p>\n                  )}\n                </div>\n\n                <button\n                  onClick={() => handleBuyItem(sug)}\n                  className=\"px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center gap-1 shadow-xs transition-colors shrink-0\"\n                >\n                  <ShoppingCart className=\"w-3.5 h-3.5\" />\n                  <span>Buy</span>\n                </button>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Main Pantry Stock Table */}\n      <div className=\"rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden\">\n        <div className=\"p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between\">\n          <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            Current Pantry Inventory\n          </h3>\n          <span className=\"text-xs text-slate-500 dark:text-slate-400\">\n            {items.length} items total\n          </span>\n        </div>\n\n        {items.length === 0 ? (\n          <div className=\"p-12 text-center\">\n            <div className=\"w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-400\">\n              <Package className=\"w-8 h-8\" />\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n              Pantry is Empty\n            </h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto mt-1 mb-4\">\n              Add rice, flour, eggs, olive oil, spices, or cleaning supplies to monitor household inventory.\n            </p>\n            <button\n              onClick={() => setIsAddModalOpen(true)}\n              className=\"px-4 py-2 rounded-xl text-xs font-bold text-white bg-sky-600 hover:bg-sky-500 transition-colors shadow-xs\"\n            >\n              + Add First Item\n            </button>\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n                  <th className=\"py-3.5 px-6\">Item</th>\n                  <th className=\"py-3.5 px-6\">Category</th>\n                  <th className=\"py-3.5 px-6\">Quantity in Stock</th>\n                  <th className=\"py-3.5 px-6\">Threshold</th>\n                  <th className=\"py-3.5 px-6\">Status</th>\n                  <th className=\"py-3.5 px-6 text-right\">Actions</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800 text-xs\">\n                {items.map((item) => {\n                  const isLow = item.quantity <= item.min_threshold;\n                  return (\n                    <tr key={item.id} className=\"hover:bg-slate-50/50 dark:hover:bg-slate-800/50 transition-colors\">\n                      <td className=\"py-4 px-6 font-bold text-slate-900 dark:text-white\">\n                        {item.name}\n                      </td>\n                      <td className=\"py-4 px-6 text-slate-500 dark:text-slate-400\">\n                        {item.category}\n                      </td>\n                      <td className=\"py-4 px-6\">\n                        <div className=\"flex items-center gap-2\">\n                          <button\n                            onClick={() => handleAdjustQuantity(item, -1)}\n                            className=\"w-6 h-6 rounded-md bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 flex items-center justify-center transition-colors font-bold\"\n                          >\n                            <Minus className=\"w-3.5 h-3.5\" />\n                          </button>\n                          <span className=\"font-extrabold text-sm text-slate-900 dark:text-white min-w-[36px] text-center\">\n                            {item.quantity} {item.unit}\n                          </span>\n                          <button\n                            onClick={() => handleAdjustQuantity(item, 1)}\n                            className=\"w-6 h-6 rounded-md bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 flex items-center justify-center transition-colors font-bold\"\n                          >\n                            <Plus className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n                      </td>\n                      <td className=\"py-4 px-6 text-slate-500 dark:text-slate-400\">\n                        {item.min_threshold} {item.unit}\n                      </td>\n                      <td className=\"py-4 px-6\">\n                        {isLow ? (\n                          <span className=\"px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300\">\n                            ⚠ Low Stock\n                          </span>\n                        ) : (\n                          <span className=\"px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300\">\n                            ✓ In Stock\n                          </span>\n                        )}\n                      </td>\n                      <td className=\"py-4 px-6 text-right\">\n                        <div className=\"flex items-center justify-end gap-1.5\">\n                          <button\n                            onClick={() => handleBuyItem(item)}\n                            title=\"Purchase more\"\n                            className=\"px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 font-semibold text-xs transition-colors\"\n                          >\n                            Restock\n                          </button>\n                          <button\n                            onClick={() => handleDelete(item.id)}\n                            title=\"Delete\"\n                            className=\"p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-colors\"\n                          >\n                            <Trash2 className=\"w-4 h-4\" />\n                          </button>\n                        </div>\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      {/* Modals */}\n      <AddPantryModal\n        isOpen={isAddModalOpen}\n        onClose={() => setIsAddModalOpen(false)}\n        onSuccess={fetchPantryData}\n      />\n      <MarketPurchaseModal\n        isOpen={isMarketModalOpen}\n        onClose={() => {\n          setIsMarketModalOpen(false);\n          setPreselectedPurchaseItem(null);\n        }}\n        onSuccess={fetchPantryData}\n        preselectedItem={preselectedPurchaseItem}\n        pantryItems={items}\n      />\n    </div>\n  );\n}\n'@ | Out-File -FilePath \"client\\src\\components\\Pantry.jsx\" -Encoding utf8","Cwd":"C:\\Users\\HP\\.gemini\\antigravity\\scratch\\household-app","WaitMsBeforeAsync":5000,"toolAction":"Writing Pantry component","toolSummary":"Write Pantry.jsx"}}]}
