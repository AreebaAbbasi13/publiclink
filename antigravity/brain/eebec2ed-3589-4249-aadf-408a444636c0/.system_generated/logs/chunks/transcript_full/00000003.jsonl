{"step_index":260,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-02T13:56:50Z","tool_calls":[{"name":"run_command","args":{"CommandLine":"@'\nimport React from 'react';\nimport { X, Bell, AlertTriangle, Clock, AlertCircle, ShoppingCart, RefreshCw, CheckCircle2 } from 'lucide-react';\n\nexport default function NotificationsDrawer({ isOpen, onClose, notifications = [], onRefresh, onNavigate }) {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-hidden animate-fade-in\">\n      {/* Backdrop */}\n      <div\n        className=\"absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity\"\n        onClick={onClose}\n      />\n\n      <div className=\"fixed inset-y-0 right-0 max-w-full flex pl-10\">\n        <div className=\"w-screen max-w-md bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-2xl flex flex-col\">\n          {/* Header */}\n          <div className=\"p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold\">\n                <Bell className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n                  Notifications & Reminders\n                </h3>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                  {notifications.length} active household alerts\n                </p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={onRefresh}\n                title=\"Refresh Reminders\"\n                className=\"p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n              >\n                <RefreshCw className=\"w-4 h-4\" />\n              </button>\n              <button\n                onClick={onClose}\n                className=\"p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* List Body */}\n          <div className=\"flex-1 overflow-y-auto p-6 space-y-3\">\n            {notifications.length === 0 ? (\n              <div className=\"flex flex-col items-center justify-center py-16 text-center\">\n                <div className=\"w-14 h-14 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-500 flex items-center justify-center mb-3\">\n                  <CheckCircle2 className=\"w-7 h-7\" />\n                </div>\n                <h4 className=\"text-sm font-semibold text-slate-800 dark:text-slate-200\">\n                  All Clear!\n                </h4>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-xs mt-1\">\n                  No overdue bills, upcoming due date deadlines, or low stock pantry items at this moment.\n                </p>\n              </div>\n            ) : (\n              notifications.map((notif) => {\n                const isDanger = notif.urgency === 'danger';\n                const isWarning = notif.urgency === 'warning';\n\n                return (\n                  <div\n                    key={notif.id}\n                    className={`p-4 rounded-2xl border transition-all duration-150 ${\n                      isDanger\n                        ? 'bg-rose-50/70 dark:bg-rose-950/30 border-rose-200 dark:border-rose-900/60 text-rose-900 dark:text-rose-100'\n                        : isWarning\n                        ? 'bg-amber-50/70 dark:bg-amber-950/30 border-amber-200 dark:border-amber-900/60 text-amber-900 dark:text-amber-100'\n                        : 'bg-sky-50/70 dark:bg-sky-950/30 border-sky-200 dark:border-sky-900/60 text-sky-900 dark:text-sky-100'\n                    }`}\n                  >\n                    <div className=\"flex items-start gap-3\">\n                      <div className=\"mt-0.5 shrink-0\">\n                        {notif.type === 'bill_reminder' && isDanger && <AlertCircle className=\"w-5 h-5 text-rose-600 dark:text-rose-400\" />}\n                        {notif.type === 'bill_reminder' && !isDanger && <Clock className=\"w-5 h-5 text-amber-600 dark:text-amber-400\" />}\n                        {notif.type === 'pantry_low' && <ShoppingCart className=\"w-5 h-5 text-amber-600 dark:text-amber-400\" />}\n                        {(notif.type === 'budget_alert' || notif.type === 'saving_alert') && <AlertTriangle className=\"w-5 h-5 text-rose-600 dark:text-rose-400\" />}\n                      </div>\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center justify-between gap-2\">\n                          <h4 className=\"text-xs font-bold truncate\">\n                            {notif.title}\n                          </h4>\n                          {notif.level && (\n                            <span className=\"px-1.5 py-0.5 rounded text-[10px] font-extrabold uppercase bg-white/60 dark:bg-black/30 shrink-0\">\n                              {notif.level.replace('_', ' ')}\n                            </span>\n                          )}\n                        </div>\n                        <p className=\"text-xs mt-1 opacity-90 leading-relaxed\">\n                          {notif.message}\n                        </p>\n\n                        {/* Direct Action Button */}\n                        <div className=\"mt-2.5 flex items-center gap-2\">\n                          {notif.type === 'bill_reminder' && (\n                            <button\n                              onClick={() => {\n                                onNavigate('bills');\n                                onClose();\n                              }}\n                              className=\"text-[11px] font-bold underline hover:opacity-80 transition-opacity\"\n                            >\n                              Go to Bills & Rent →\n                            </button>\n                          )}\n                          {notif.type === 'pantry_low' && (\n                            <button\n                              onClick={() => {\n                                onNavigate('pantry');\n                                onClose();\n                              }}\n                              className=\"text-[11px] font-bold underline hover:opacity-80 transition-opacity\"\n                            >\n                              View Suggested Shopping List →\n                            </button>\n                          )}\n                          {(notif.type === 'budget_alert' || notif.type === 'saving_alert') && (\n                            <button\n                              onClick={() => {\n                                onNavigate('budget');\n                                onClose();\n                              }}\n                              className=\"text-[11px] font-bold underline hover:opacity-80 transition-opacity\"\n                            >\n                              Review Monthly Budget →\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n\n          {/* Footer */}\n          <div className=\"p-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-center\">\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              Bill reminders are calculated precisely according to bill due dates.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n'@ | Out-File -FilePath \"client\\src\\components\\NotificationsDrawer.jsx\" -Encoding utf8","Cwd":"C:\\Users\\HP\\.gemini\\antigravity\\scratch\\household-app","WaitMsBeforeAsync":5000,"toolAction":"Writing NotificationsDrawer component","toolSummary":"Write NotificationsDrawer.jsx"}}]}
