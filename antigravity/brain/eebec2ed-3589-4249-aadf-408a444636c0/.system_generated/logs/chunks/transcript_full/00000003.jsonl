{"step_index":250,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-02T13:55:16Z","tool_calls":[{"name":"run_command","args":{"CommandLine":"@'\nimport React, { useState, useEffect } from 'react';\nimport { X } from 'lucide-react';\nimport { useAuth } from '../../context/AuthContext';\nimport { useToast } from '../Toast';\n\nconst CATEGORIES = ['Food', 'Transport', 'Utility', 'Other daily expenses'];\n\nexport default function AddExpenseModal({ isOpen, onClose, onSuccess, initialExpense = null }) {\n  const { authFetch, user } = useAuth();\n  const { success, error } = useToast();\n\n  const [title, setTitle] = useState('');\n  const [category, setCategory] = useState(CATEGORIES[0]);\n  const [amount, setAmount] = useState('');\n  const [expenseDate, setExpenseDate] = useState('');\n  const [notes, setNotes] = useState('');\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    if (initialExpense) {\n      setTitle(initialExpense.title);\n      setCategory(initialExpense.category);\n      setAmount(initialExpense.amount.toString());\n      setExpenseDate(initialExpense.expense_date);\n      setNotes(initialExpense.notes || '');\n    } else {\n      setTitle('');\n      setCategory(CATEGORIES[0]);\n      setAmount('');\n      setExpenseDate(new Date().toISOString().slice(0, 10));\n      setNotes('');\n    }\n  }, [initialExpense, isOpen]);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = async (e) => {\n    e.preventDefault();\n    if (!title.trim() || !amount || !expenseDate) {\n      error('Please fill in all required fields.');\n      return;\n    }\n\n    const numAmount = parseFloat(amount);\n    if (isNaN(numAmount) || numAmount <= 0) {\n      error('Please enter a valid positive amount.');\n      return;\n    }\n\n    setLoading(true);\n    try {\n      const url = initialExpense ? `/api/expenses/${initialExpense.id}` : '/api/expenses';\n      const method = initialExpense ? 'PUT' : 'POST';\n\n      const res = await authFetch(url, {\n        method,\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          title: title.trim(),\n          category,\n          amount: numAmount,\n          expense_date: expenseDate,\n          notes: notes.trim()\n        })\n      });\n\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || 'Failed to save expense');\n\n      success(initialExpense ? 'Expense updated successfully!' : 'Expense recorded successfully!');\n      onSuccess();\n      onClose();\n    } catch (err) {\n      error(err.message || 'Operation failed');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in\">\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        <div className=\"flex items-center justify-between p-6 border-b border-slate-100 dark:border-slate-800\">\n          <div>\n            <h3 className=\"text-lg font-bold text-slate-900 dark:text-white\">\n              {initialExpense ? 'Edit Daily Expense' : 'Add Daily Expense'}\n            </h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-0.5\">\n              Record daily expenses for Food, Transport, Utilities, and more.\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"p-6 overflow-y-auto space-y-4\">\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n              Expense Description *\n            </label>\n            <input\n              type=\"text\"\n              required\n              placeholder=\"e.g. Grocery store run, Subway fare, Electric bulb replacement\"\n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              className=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                Category *\n              </label>\n              <select\n                value={category}\n                onChange={(e) => setCategory(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n              >\n                {CATEGORIES.map(cat => (\n                  <option key={cat} value={cat}>{cat}</option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                Amount ({user?.currency || '$'}) *\n              </label>\n              <input\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0.01\"\n                required\n                placeholder=\"0.00\"\n                value={amount}\n                onChange={(e) => setAmount(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n              Expense Date *\n            </label>\n            <input\n              type=\"date\"\n              required\n              value={expenseDate}\n              onChange={(e) => setExpenseDate(e.target.value)}\n              className=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n              Notes (Optional)\n            </label>\n            <textarea\n              rows={2}\n              placeholder=\"Receipt details or notes...\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              className=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 resize-none\"\n            />\n          </div>\n\n          <div className=\"pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-3\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              disabled={loading}\n              className=\"px-4 py-2.5 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 transition-colors shadow-sm\"\n            >\n              {loading ? 'Saving...' : initialExpense ? 'Update Expense' : 'Save Expense'}\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n'@ | Out-File -FilePath \"client\\src\\components\\Modals\\AddExpenseModal.jsx\" -Encoding utf8","Cwd":"C:\\Users\\HP\\.gemini\\antigravity\\scratch\\household-app","WaitMsBeforeAsync":5000,"toolAction":"Writing AddExpenseModal component","toolSummary":"Write AddExpenseModal.jsx"}}]}
