{"step_index":365,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-02T15:28:00Z","content":"Now create the email service with full HTML templates and SMTP support:","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Backend email service using nodemailer with professional HTML templates for bill reminders, pantry low-stock alerts, and budget warnings. Supports SMTP, Gmail, SendGrid, Resend, and Ethereal test accounts.","UserFacing":false},"CodeContent":"const nodemailer = require('nodemailer');\n\n// ─── Transporter Factory ─────────────────────────────────────────────────────\n// Reads from environment variables – never hardcoded.\n// Supported modes (set SMTP_HOST or MAIL_PROVIDER):\n//   1. Generic SMTP  – SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE\n//   2. Gmail         – MAIL_PROVIDER=gmail, GMAIL_USER, GMAIL_APP_PASSWORD\n//   3. Resend        – MAIL_PROVIDER=resend, RESEND_API_KEY\n//   4. Auto test     – none of the above → Ethereal test account (console URL)\n\nasync function createTransporter() {\n  const provider = (process.env.MAIL_PROVIDER || '').toLowerCase();\n\n  if (provider === 'gmail') {\n    if (!process.env.GMAIL_USER || !process.env.GMAIL_APP_PASSWORD) {\n      throw new Error('Gmail requires GMAIL_USER and GMAIL_APP_PASSWORD env vars.');\n    }\n    return nodemailer.createTransport({\n      service: 'gmail',\n      auth: {\n        user: process.env.GMAIL_USER,\n        pass: process.env.GMAIL_APP_PASSWORD,\n      },\n    });\n  }\n\n  if (provider === 'resend') {\n    if (!process.env.RESEND_API_KEY) {\n      throw new Error('Resend requires RESEND_API_KEY env var.');\n    }\n    return nodemailer.createTransport({\n      host: 'smtp.resend.com',\n      port: 465,\n      secure: true,\n      auth: {\n        user: 'resend',\n        pass: process.env.RESEND_API_KEY,\n      },\n    });\n  }\n\n  if (process.env.SMTP_HOST) {\n    return nodemailer.createTransport({\n      host: process.env.SMTP_HOST,\n      port: parseInt(process.env.SMTP_PORT || '587', 10),\n      secure: process.env.SMTP_SECURE === 'true',\n      auth: {\n        user: process.env.SMTP_USER,\n        pass: process.env.SMTP_PASS,\n      },\n    });\n  }\n\n  // Fallback: Ethereal test account – previews are logged to the console\n  const testAccount = await nodemailer.createTestAccount();\n  console.log('[EmailService] No SMTP credentials found – using Ethereal test account.');\n  console.log(`[EmailService] Ethereal user: ${testAccount.user}`);\n  return nodemailer.createTransport({\n    host: 'smtp.ethereal.email',\n    port: 587,\n    secure: false,\n    auth: { user: testAccount.user, pass: testAccount.pass },\n  });\n}\n\nconst FROM_ADDRESS =\n  process.env.SMTP_FROM ||\n  process.env.GMAIL_USER ||\n  '\"HomeSphere\" <notifications@homesphere.app>';\n\n// ─── HTML Template Builder ────────────────────────────────────────────────────\nfunction buildEmailHtml({ userName, title, bodyHtml, ctaText = null, urgencyColor = '#0ea5e9' }) {\n  return `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>${title}</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;padding:32px 16px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.07);\">\n          <!-- Header -->\n          <tr>\n            <td style=\"background:linear-gradient(135deg,${urgencyColor} 0%,#6366f1 100%);padding:28px 36px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td>\n                    <span style=\"display:inline-block;background:rgba(255,255,255,0.2);border-radius:10px;padding:8px 14px;font-size:20px;font-weight:900;color:#ffffff;letter-spacing:-0.5px;\">HS</span>\n                  </td>\n                  <td align=\"right\">\n                    <span style=\"color:rgba(255,255,255,0.85);font-size:12px;font-weight:600;\">HomeSphere Household Manager</span>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:36px 36px 28px;\">\n              <p style=\"margin:0 0 6px;font-size:13px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:0.8px;\">Hello, ${userName}</p>\n              <h1 style=\"margin:0 0 20px;font-size:22px;font-weight:800;color:#0f172a;line-height:1.3;\">${title}</h1>\n              ${bodyHtml}\n              ${ctaText ? `\n              <div style=\"margin-top:28px;\">\n                <a href=\"#\" style=\"display:inline-block;padding:12px 24px;background:${urgencyColor};color:#ffffff;font-weight:700;font-size:14px;border-radius:10px;text-decoration:none;\">${ctaText}</a>\n              </div>` : ''}\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"background:#f8fafc;padding:20px 36px;border-top:1px solid #e2e8f0;\">\n              <p style=\"margin:0;font-size:12px;color:#94a3b8;line-height:1.6;\">\n                This notification was sent by <strong>HomeSphere</strong> based on your household data.<br/>\n                Manage your bills, expenses, pantry, and budget at your HomeSphere dashboard.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n}\n\n// ─── Specific Email Composers ─────────────────────────────────────────────────\n\nfunction composeBillReminderEmail({ userName, bill, daysLeft, hoursLeft, isOverdue, currency }) {\n  let urgencyColor = '#0ea5e9';\n  let badge = '';\n  let headline = '';\n  let detailLine = '';\n\n  if (isOverdue) {\n    urgencyColor = '#ef4444';\n    const daysOverdue = Math.abs(daysLeft);\n    badge = `<span style=\"display:inline-block;padding:4px 12px;background:#fef2f2;color:#ef4444;font-size:11px;font-weight:700;border-radius:99px;margin-bottom:16px;border:1px solid #fecaca;\">🔴 OVERDUE</span>`;\n    headline = `Your ${bill.category} payment is overdue!`;\n    detailLine = `This bill was due on <strong>${bill.due_date}</strong> — ${daysOverdue} day(s) ago.`;\n  } else if (hoursLeft !== null && hoursLeft <= 24) {\n    urgencyColor = '#ef4444';\n    badge = `<span style=\"display:inline-block;padding:4px 12px;background:#fef2f2;color:#ef4444;font-size:11px;font-weight:700;border-radius:99px;margin-bottom:16px;border:1px solid #fecaca;\">🚨 DUE TODAY</span>`;\n    headline = `Bill due today – ${hoursLeft} hour(s) remaining!`;\n    detailLine = `This payment is due <strong>today (${bill.due_date})</strong>. Act now to avoid late fees.`;\n  } else if (daysLeft <= 3) {\n    urgencyColor = '#f97316';\n    badge = `<span style=\"display:inline-block;padding:4px 12px;background:#fff7ed;color:#ea580c;font-size:11px;font-weight:700;border-radius:99px;margin-bottom:16px;border:1px solid #fed7aa;\">⚠️ ${daysLeft} DAY(S) LEFT</span>`;\n    headline = `${bill.name} is due in ${daysLeft} day(s)`;\n    detailLine = `Payment deadline is <strong>${bill.due_date}</strong>.`;\n  } else {\n    urgencyColor = '#0ea5e9';\n    badge = `<span style=\"display:inline-block;padding:4px 12px;background:#eff6ff;color:#2563eb;font-size:11px;font-weight:700;border-radius:99px;margin-bottom:16px;border:1px solid #bfdbfe;\">📅 ${daysLeft} DAYS LEFT</span>`;\n    headline = `Upcoming: ${bill.name} in ${daysLeft} days`;\n    detailLine = `Schedule your payment before <strong>${bill.due_date}</strong>.`;\n  }\n\n  const bodyHtml = `\n    ${badge}\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border-radius:12px;padding:20px;margin-bottom:16px;\">\n      <tr>\n        <td style=\"font-size:13px;color:#64748b;font-weight:600;padding-bottom:8px;\">Bill Details</td>\n      </tr>\n      <tr>\n        <td style=\"font-size:28px;font-weight:900;color:#0f172a;\">${currency}${bill.amount.toFixed(2)}</td>\n      </tr>\n      <tr>\n        <td style=\"font-size:14px;font-weight:700;color:#1e293b;padding-top:6px;\">${bill.name}</td>\n      </tr>\n      <tr>\n        <td style=\"font-size:12px;color:#64748b;padding-top:4px;\">Category: ${bill.category}</td>\n      </tr>\n    </table>\n    <p style=\"margin:0;font-size:14px;color:#334155;line-height:1.7;\">${detailLine}</p>\n    ${bill.notes ? `<p style=\"margin:12px 0 0;font-size:13px;color:#94a3b8;font-style:italic;\">Note: ${bill.notes}</p>` : ''}\n  `;\n\n  return {\n    subject: isOverdue\n      ? `🔴 Overdue: ${bill.name} — ${currency}${bill.amount.toFixed(2)}`\n      : hoursLeft !== null && hoursLeft <= 24\n      ? `🚨 Due Today: ${bill.name} — ${currency}${bill.amount.toFixed(2)}`\n      : `📅 ${daysLeft}d Left: ${bill.name} — ${currency}${bill.amount.toFixed(2)}`,\n    html: buildEmailHtml({\n      userName,\n      title: headline,\n      bodyHtml,\n      ctaText: 'Open HomeSphere Dashboard',\n      urgencyColor,\n    }),\n  };\n}\n\nfunction composePantryAlertEmail({ userName, items, currency }) {\n  const outOfStock = items.filter(i => i.quantity === 0);\n  const runningLow = items.filter(i => i.quantity > 0);\n\n  const itemRows = items.map(item => `\n    <tr style=\"border-bottom:1px solid #e2e8f0;\">\n      <td style=\"padding:10px 0;font-size:13px;font-weight:700;color:#1e293b;\">${item.name}</td>\n      <td style=\"padding:10px 0;font-size:13px;color:${item.quantity === 0 ? '#ef4444' : '#f97316'};font-weight:600;text-align:right;\">\n        ${item.quantity === 0 ? '⛔ Out of Stock' : `⚠️ ${item.quantity} ${item.unit} left`}\n      </td>\n    </tr>\n  `).join('');\n\n  const bodyHtml = `\n    <p style=\"margin:0 0 16px;font-size:14px;color:#334155;line-height:1.7;\">\n      Your pantry inventory needs attention. \n      ${outOfStock.length > 0 ? `<strong>${outOfStock.length} item(s) are completely out of stock.</strong>` : ''}\n      ${runningLow.length > 0 ? `${runningLow.length} item(s) are running low.` : ''}\n    </p>\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border-radius:12px;padding:16px 20px;margin-bottom:16px;\">\n      <thead>\n        <tr>\n          <th style=\"font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.8px;text-align:left;padding-bottom:8px;\">Item</th>\n          <th style=\"font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.8px;text-align:right;padding-bottom:8px;\">Status</th>\n        </tr>\n      </thead>\n      <tbody>${itemRows}</tbody>\n    </table>\n  `;\n\n  return {\n    subject: `🛒 Pantry Alert: ${items.length} item(s) need restocking`,\n    html: buildEmailHtml({\n      userName,\n      title: `${items.length} Pantry Item(s) Need Restocking`,\n      bodyHtml,\n      ctaText: 'View Pantry & Suggested List',\n      urgencyColor: '#f97316',\n    }),\n  };\n}\n\nfunction composeBudgetAlertEmail({ userName, totalSpent, monthlyLimit, spentPct, currency, month }) {\n  const isExceeded = totalSpent >= monthlyLimit;\n  const remaining = monthlyLimit - totalSpent;\n  const urgencyColor = isExceeded ? '#ef4444' : '#f97316';\n\n  const bodyHtml = `\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border-radius:12px;padding:20px;margin-bottom:20px;\">\n      <tr>\n        <td style=\"font-size:13px;color:#64748b;font-weight:600;\">Budget for ${month}</td>\n      </tr>\n      <tr>\n        <td>\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:12px;\">\n            <tr>\n              <td style=\"font-size:12px;color:#64748b;\">Monthly Target</td>\n              <td style=\"font-size:14px;font-weight:800;color:#0f172a;text-align:right;\">${currency}${monthlyLimit.toFixed(2)}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size:12px;color:#64748b;padding-top:6px;\">Total Spent</td>\n              <td style=\"font-size:14px;font-weight:800;color:${urgencyColor};text-align:right;padding-top:6px;\">${currency}${totalSpent.toFixed(2)}</td>\n            </tr>\n            <tr>\n              <td style=\"font-size:12px;color:#64748b;padding-top:6px;\">${isExceeded ? 'Overspend' : 'Remaining'}</td>\n              <td style=\"font-size:14px;font-weight:800;color:${isExceeded ? '#ef4444' : '#16a34a'};text-align:right;padding-top:6px;\">${currency}${Math.abs(remaining).toFixed(2)}</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding-top:16px;\">\n          <div style=\"background:#e2e8f0;border-radius:99px;height:8px;overflow:hidden;\">\n            <div style=\"background:${urgencyColor};width:${Math.min(100, spentPct).toFixed(0)}%;height:8px;border-radius:99px;\"></div>\n          </div>\n          <p style=\"margin:6px 0 0;font-size:12px;color:${urgencyColor};font-weight:700;\">${spentPct.toFixed(0)}% of budget used</p>\n        </td>\n      </tr>\n    </table>\n    <p style=\"margin:0;font-size:14px;color:#334155;line-height:1.7;\">\n      ${isExceeded\n        ? `You have exceeded your monthly budget by <strong>${currency}${Math.abs(remaining).toFixed(2)}</strong>. Review discretionary expenses and defer optional purchases to stay on track.`\n        : `You have used ${spentPct.toFixed(0)}% of your budget. Only <strong>${currency}${remaining.toFixed(2)}</strong> remains for ${month}.`\n      }\n    </p>\n  `;\n\n  return {\n    subject: isExceeded\n      ? `🔴 Budget Exceeded: You've spent ${currency}${totalSpent.toFixed(2)} of ${currency}${monthlyLimit.toFixed(2)}`\n      : `⚠️ Budget Alert: ${spentPct.toFixed(0)}% of your ${month} budget is used`,\n    html: buildEmailHtml({\n      userName,\n      title: isExceeded ? 'Monthly Budget Exceeded' : `Budget Running Low (${spentPct.toFixed(0)}% Used)`,\n      bodyHtml,\n      ctaText: 'View Budget Dashboard',\n      urgencyColor,\n    }),\n  };\n}\n\n// ─── Core Send Function ───────────────────────────────────────────────────────\nlet _transporter = null;\n\nasync function getTransporter() {\n  if (!_transporter) {\n    _transporter = await createTransporter();\n  }\n  return _transporter;\n}\n\nasync function sendEmail({ to, subject, html }) {\n  try {\n    const transporter = await getTransporter();\n    const info = await transporter.sendMail({\n      from: FROM_ADDRESS,\n      to,\n      subject,\n      html,\n    });\n\n    // Log Ethereal preview URL when using test accounts\n    const previewUrl = nodemailer.getTestMessageUrl(info);\n    if (previewUrl) {\n      console.log(`[EmailService] ✉️  Email preview (Ethereal): ${previewUrl}`);\n    } else {\n      console.log(`[EmailService] ✉️  Email sent to ${to}: ${info.messageId}`);\n    }\n    return { success: true, messageId: info.messageId, previewUrl };\n  } catch (err) {\n    console.error(`[EmailService] ❌ Failed to send email to ${to}:`, err.message);\n    return { success: false, error: err.message };\n  }\n}\n\nmodule.exports = {\n  sendEmail,\n  composeBillReminderEmail,\n  composePantryAlertEmail,\n  composeBudgetAlertEmail,\n};\n","Description":"Backend email service with nodemailer, SMTP/Gmail/Resend/Ethereal support, and professional HTML templates for bill reminders, pantry alerts, and budget warnings.","Overwrite":false,"TargetFile":"C:\\Users\\HP\\.gemini\\antigravity\\scratch\\household-app\\server\\services\\emailService.js","toolAction":"Creating email service","toolSummary":"Write emailService.js"}}]}
{"step_index":367,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-02T15:29:03Z","tool_calls":[{"name":"run_command","args":{"CommandLine":"@'\nconst nodemailer = require('nodemailer');\n\n// Transporter Factory\n// Supported modes (set SMTP_HOST or MAIL_PROVIDER env var):\n//   1. Generic SMTP  – SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE\n//   2. Gmail         – MAIL_PROVIDER=gmail, GMAIL_USER, GMAIL_APP_PASSWORD\n//   3. Resend        – MAIL_PROVIDER=resend, RESEND_API_KEY\n//   4. Auto test     – no credentials → Ethereal test account (preview URL logged)\n\nasync function createTransporter() {\n  const provider = (process.env.MAIL_PROVIDER || '').toLowerCase();\n\n  if (provider === 'gmail') {\n    if (!process.env.GMAIL_USER || !process.env.GMAIL_APP_PASSWORD) {\n      throw new Error('Gmail requires GMAIL_USER and GMAIL_APP_PASSWORD env vars.');\n    }\n    return nodemailer.createTransport({\n      service: 'gmail',\n      auth: { user: process.env.GMAIL_USER, pass: process.env.GMAIL_APP_PASSWORD },\n    });\n  }\n\n  if (provider === 'resend') {\n    if (!process.env.RESEND_API_KEY) throw new Error('Resend requires RESEND_API_KEY env var.');\n    return nodemailer.createTransport({\n      host: 'smtp.resend.com', port: 465, secure: true,\n      auth: { user: 'resend', pass: process.env.RESEND_API_KEY },\n    });\n  }\n\n  if (process.env.SMTP_HOST) {\n    return nodemailer.createTransport({\n      host: process.env.SMTP_HOST,\n      port: parseInt(process.env.SMTP_PORT || '587', 10),\n      secure: process.env.SMTP_SECURE === 'true',\n      auth: { user: process.env.SMTP_USER, pass: process.env.SMTP_PASS },\n    });\n  }\n\n  // Fallback: Ethereal test account\n  const testAccount = await nodemailer.createTestAccount();\n  console.log('[EmailService] No SMTP credentials - using Ethereal test account.');\n  console.log(`[EmailService] Ethereal user: ${testAccount.user}`);\n  return nodemailer.createTransport({\n    host: 'smtp.ethereal.email', port: 587, secure: false,\n    auth: { user: testAccount.user, pass: testAccount.pass },\n  });\n}\n\nconst FROM_ADDRESS = process.env.SMTP_FROM || process.env.GMAIL_USER || '\"HomeSphere\" <notifications@homesphere.app>';\n\nfunction buildEmailHtml({ userName, title, bodyHtml, ctaText = null, urgencyColor = '#0ea5e9' }) {\n  return `<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"/><title>${title}</title></head>\n<body style=\"margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.07);\">\n        <tr>\n          <td style=\"background:linear-gradient(135deg,${urgencyColor} 0%,#6366f1 100%);padding:28px 36px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n              <tr>\n                <td><span style=\"display:inline-block;background:rgba(255,255,255,0.2);border-radius:10px;padding:8px 14px;font-size:20px;font-weight:900;color:#ffffff;\">HS</span></td>\n                <td align=\"right\"><span style=\"color:rgba(255,255,255,0.85);font-size:12px;font-weight:600;\">HomeSphere Household Manager</span></td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:36px 36px 28px;\">\n            <p style=\"margin:0 0 6px;font-size:13px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:0.8px;\">Hello, ${userName}</p>\n            <h1 style=\"margin:0 0 20px;font-size:22px;font-weight:800;color:#0f172a;line-height:1.3;\">${title}</h1>\n            ${bodyHtml}\n            ${ctaText ? `<div style=\"margin-top:28px;\"><a href=\"#\" style=\"display:inline-block;padding:12px 24px;background:${urgencyColor};color:#ffffff;font-weight:700;font-size:14px;border-radius:10px;text-decoration:none;\">${ctaText}</a></div>` : ''}\n          </td>\n        </tr>\n        <tr>\n          <td style=\"background:#f8fafc;padding:20px 36px;border-top:1px solid #e2e8f0;\">\n            <p style=\"margin:0;font-size:12px;color:#94a3b8;line-height:1.6;\">\n              This notification was sent by <strong>HomeSphere</strong> based on your household ledger data.\n            </p>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body></html>`;\n}\n\nfunction composeBillReminderEmail({ userName, bill, daysLeft, hoursLeft, isOverdue, currency }) {\n  let urgencyColor = '#0ea5e9';\n  let badge = '';\n  let headline = '';\n  let detailLine = '';\n\n  if (isOverdue) {\n    urgencyColor = '#ef4444';\n    const daysOverdue = Math.abs(daysLeft);\n    badge = `<span style=\"display:inline-block;padding:4px 12px;background:#fef2f2;color:#ef4444;font-size:11px;font-weight:700;border-radius:99px;margin-bottom:16px;border:1px solid #fecaca;\">OVERDUE</span>`;\n    headline = `${bill.name} is overdue!`;\n    detailLine = `This bill was due on <strong>${bill.due_date}</strong> — ${daysOverdue} day(s) ago.`;\n  } else if (hoursLeft !== null && hoursLeft <= 24) {\n    urgencyColor = '#ef4444';\n    badge = `<span style=\"display:inline-block;padding:4px 12px;background:#fef2f2;color:#ef4444;font-size:11px;font-weight:700;border-radius:99px;margin-bottom:16px;border:1px solid #fecaca;\">DUE TODAY - ${Math.round(hoursLeft)} hours left</span>`;\n 