;\n97:   }\n98: });\n99: \n100: // GET /api/auth/me\n101: router.get('/me', authMiddleware, (req, res) => {\n102:   return res.json({ user: req.user });\n103: });\n104: \n105: // PUT /api/auth/profile\n106: router.put('/profile', authMiddleware, (req, res) => {\n107:   const { name, currency } = req.body;\n108:   if (!name) {\n109:     return res.status(400).json({ error: 'Name cannot be empty.' });\n110:   }\n111: \n112:   try {\n113:     db.prepare('UPDATE users SET name = ?, currency = ? WHERE id = ?').run(\n114:       name.trim(),\n115:       currency || '$',\n116:       req.user.id\n117:     );\n118: \n119:     const updated = db.prepare('SELECT id, name, email, currency FROM users WHERE id = ?').get(req.user.id);\n120:     return res.json({ message: 'Profile updated successfully.', user: updated });\n121:   } catch (err) {\n122:     return res.status(500).json({ error: 'Failed to update profile.' });\n123:   }\n124: });\n125: \n126: module.exports = router;\r\n127: \nThe above content shows the entire, complete file contents of the requested file.\n"}
