{"step_index":374,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-02T15:31:19Z","content":"Created At: 2026-09-02T08:31:19-07:00\nCompleted At: 2026-09-02T08:31:20-07:00\nFile Path: `file:///C:/Users/HP/.gemini/antigravity/scratch/household-app/server/routes/bills.js`\nTotal Lines: 221\nTotal Bytes: 6993\nShowing lines 1 to 221\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const express = require('express');\n2: const db = require('../db/database');\n3: const { authMiddleware } = require('../middleware/auth');\n4: \n5: const router = express.Router();\n6: router.use(authMiddleware);\n7: \n8: const ALLOWED_CATEGORIES = [\n9:   'Rent',\n10:   'Water bill',\n11:   'Electricity bill',\n12:   'Gas bill',\n13:   'Internet bill',\n14:   'School fees',\n15:   'College fees',\n16:   'University fees',\n17:   'Household help fees',\n18:   'Education fees',\n19:   'Household fees',\n20:   'Online shopping payments',\n21:   'Package amounts'\n22: ];\n23: \n24: function computeStatus(dueDate, currentStatus, paymentDate) {\n25:   if (currentStatus === 'Paid' || paymentDate) return 'Paid';\n26:   const due = new Date(dueDate + 'T23:59:59');\n27:   const now = new Date();\n28:   return due < now ? 'Overdue' : 'Pending';\n29: }\n30: \n31: // GET /api/bills\n32: router.get('/', (req, res) => {\n33:   try {\n34:     const { month, category, status } = req.query;\n35:     let query = 'SELECT * FROM bills WHERE user_id = ?';\n36:     const params = [req.user.id];\n37: \n38:     if (month) {\n39:       query += ' AND (due_date LIKE ? OR payment_date LIKE ?)';\n40:       params.push(`${month}%`, `${month}%`);\n41:     }\n42:     if (category && category !== 'all') {\n43:       query += ' AND category = ?';\n44:       params.push(category);\n45:     }\n46: \n47:     query += ' ORDER BY due_date ASC';\n48:     const rows = db.prepare(query).all(...params);\n49: \n50:     const updatedRows = rows.map(bill => {\n51:       const realStatus = computeStatus(bill.due_date, bill.status, bill.payment_date);\n52:       if (realStatus !== bill.status) {\n53:         db.prepare('UPDATE bills SET status = ? WHERE id = ?').run(realStatus, bill.id);\n54:         bill.status = realStatus;\n55:       }\n56:       return bill;\n57:     });\n58: \n59:     if (status && status !== 'all') {\n60:       return res.json(updatedRows.filter(b => b.status.toLowerCase() === status.toLowerCase()));\n61:     }\n62: \n63:     return res.json(updatedRows);\n64:   } catch (err) {\n65:     console.error('Fetch bills error:', err);\n66:     return res.status(500).json({ error: 'Failed to fetch bills.' });\n67:   }\n68: });\n69: \n70: // POST /api/bills\n71: router.post('/', (req, res) => {\n72:   const { name, category, amount, due_date, notes = '' } = req.body;\n73: \n74:   if (!name || !category || amount === undefined || !due_date) {\n75:     return res.status(400).json({ error: 'Name, category, amount, and due date are required.' });\n76:   }\n77: \n78:   if (Number(amount) <= 0) {\n79:     return res.status(400).json({ error: 'Amount must be greater than 0.' });\n80:   }\n81: \n82:   const initialStatus = computeStatus(due_date, 'Pending', null);\n83: \n84:   try {\n85:     const result = db.prepare(`\n86:       INSERT INTO bills (user_id, name, category, amount, due_date, status, notes)\n87:       VALUES (?, ?, ?, ?, ?, ?, ?)\n88:     `).run(req.user.id, name.trim(), category, Number(amount), due_date, initialStatus, notes);\n89: \n90:     const created = db.prepare('SELECT * FROM bills WHERE id = ?').get(result.lastInsertRowid);\n91:     return res.status(201).json({ message: 'Bill added successfully.', bill: created });\n92:   } catch (err) {\n93:     console.error('Create bill error:', err);\n94:     return res.status(500).json({ error: 'Failed to add bill.' });\n95:   }\n96: });\n97: \n98: // PUT /api/bills/:id/pay\n99: router.put('/:id/pay', (req, res) => {\n100:   const billId = req.params.id;\n101:   const { payment_date = new Date().toISOString().slice(0, 10), notes } = req.body;\n102: \n103:   try {\n104:     const bill = db.prepare('SELECT * FROM bills WHERE id = ? AND user_id = ?').get(billId, req.user.id);\n105:     if (!bill) {\n106:       return res.status(404).json({ error: 'Bill not found.' });\n107:     }\n108: \n109:     db.prepare(`\n110:       UPDATE bills \n111:       SET status = 'Paid', payment_date = ?, notes = COALESCE(?, notes)\n112:       WHERE id = ?\n113:     `).run(payment_date, notes || null, billId);\n114: \n115:     const updated = db.prepare('SELECT * FROM bills WHERE id = ?').get(billId);\n116:     return res.json({ message: 'Bill marked as Paid.', bill: updated });\n117:   } catch (err) {\n118:     return res.status(500).json({ error: 'Failed to update bill payment.' });\n119:   }\n120: });\n121: \n122: // PUT /api/bills/:id\n123: router.put('/:id', (req, res) => {\n124:   const billId = req.params.id;\n125:   const { name, category, amount, due_date, status, notes } = req.body;\n126: \n127:   try {\n128:     const bill = db.prepare('SELECT * FROM bills WHERE id = ? AND user_id = ?').get(billId, req.user.id);\n129:     if (!bill) {\n130:       return res.status(404).json({ error: 'Bill not found.' });\n131:     }\n132: \n133:     const nextStatus = status === 'Paid' ? 'Paid' : computeStatus(due_date || bill.due_date, status || bill.status, status === 'Paid' ? new Date().toISOString().slice(0, 10) : null);\n134: \n135:     db.prepare(`\n136:       UPDATE bills \n137:       SET name = ?, category = ?, amount = ?, due_date = ?, status = ?, notes = ?\n138:       WHERE id = ?\n139:     `).run(\n140:       name !== undefined ? name.trim() : bill.name,\n141:       category || bill.category,\n142:       amount !== undefined ? Number(amount) : bill.amount,\n143:       due_date || bill.due_date,\n144:       nextStatus,\n145:       notes !== undefined ? notes : bill.notes,\n146:       billId\n147:     );\n148: \n149:     const updated = db.prepare('SELECT * FROM bills WHERE id = ?').get(billId);\n150:     return res.json({ message: 'Bill updated successfully.', bill: updated });\n151:   } catch (err) {\n152:     return res.status(500).json({ error: 'Failed to update bill.' });\n153:   }\n154: });\n155: \n156: // DELETE /api/bills/:id\n157: router.delete('/:id', (req, res) => {\n158:   const billId = req.params.id;\n159:   try {\n160:     const result = db.prepare('DELETE FROM bills WHERE id = ? AND user_id = ?').run(billId, req.user.id);\n161:     if (result.changes === 0) {\n162:       return res.status(404).json({ error: 'Bill not found.' });\n163:     }\n164:     return res.json({ message: 'Bill deleted successfully.' });\n165:   } catch (err) {\n166:     return res.status(500).json({ error: 'Failed to delete bill.' });\n167:   }\n168: });\n169: \n170: // GET /api/bills/summary/monthly\n171: router.get('/summary/monthly', (req, res) => {\n172:   const month = req.query.month || new Date().toISOString().slice(0, 7);\n173: \n174:   try {\n175:     const bills = db.prepare(`\n176:       SELECT * FROM bills \n177:       WHERE user_id = ? AND (due_date LIKE ? OR payment_date LIKE ?)\n178:     `).all(req.user.id, `${month}%`, `${month}%`);\n179: \n180:     let totalBilled = 0;\n181:     let totalPaid = 0;\n182:     let totalPending = 0;\n183:     let totalOverdue = 0;\n184:     const categoryBreakdown = {};\n185: \n186:     for (const b of bills) {\n187:       totalBilled += b.amount;\n188:       if (b.status === 'Paid') {\n189:         totalPaid += b.amount;\n190:       } else if (b.status === 'Overdue') {\n191:         totalOverdue += b.amount;\n192:       } else {\n193:         totalPending += b.amount;\n194:       }\n195: \n196:       categoryBreakdown[b.category] = (categoryBreakdown[b.category] || 0) + b.amount;\n197:     }\n198: \n199:     const pieSlices = Object.entries(categoryBreakdown).map(([cat, val]) => ({\n200:       label: cat,\n201:       value: Number(val.toFixed(2)),\n202:       percentage: totalBilled > 0 ? Number(((val / totalBilled) * 100).toFixed(1)) : 0\n203:     }));\n204: \n205:     return res.json({\n206:       month,\n207:       totalCount: bills.length,\n208:       totalBilled: Number(totalBilled.toFixed(2)),\n209:       totalPaid: Number(totalPaid.toFixed(2)),\n210:       totalPending: Number(totalPending.toFixed(2)),\n211:       totalOverdue: Number(totalOverdue.toFixed(2)),\n212:       categoryBreakdown,\n213:       pieSlices\n214:     });\n215:   } catch (err) {\n216:     return res.status(500).json({ error: 'Failed to compute monthly bill summary.' });\n217:   }\n218: });\n219: \n220: module.exports = router;\r\n221: \nThe above content shows the entire, complete file contents of the requested file.\n"}
