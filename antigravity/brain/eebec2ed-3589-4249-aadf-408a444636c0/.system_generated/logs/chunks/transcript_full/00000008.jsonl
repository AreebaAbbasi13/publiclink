{"step_index":427,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-03T15:43:05Z","content":"Created At: 2026-09-03T08:43:05-07:00\nCompleted At: 2026-09-03T08:43:05-07:00\nFile Path: `file:///C:/Users/HP/.gemini/antigravity/scratch/household-app/server/services/emailService.js`\nTotal Lines: 235\nTotal Bytes: 12710\nShowing lines 1 to 235\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const nodemailer = require('nodemailer');\n2: \n3: // Transporter Factory\n4: // Supported modes (set SMTP_HOST or MAIL_PROVIDER env var):\n5: //   1. Generic SMTP  – SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE\n6: //   2. Gmail         – MAIL_PROVIDER=gmail, GMAIL_USER, GMAIL_APP_PASSWORD\n7: //   3. Resend        – MAIL_PROVIDER=resend, RESEND_API_KEY\n8: //   4. Auto test     – no credentials → Ethereal test account (preview URL logged)\n9: \n10: async function createTransporter() {\n11:   const provider = (process.env.MAIL_PROVIDER || '').toLowerCase();\n12: \n13:   if (provider === 'gmail') {\n14:     if (!process.env.GMAIL_USER || !process.env.GMAIL_APP_PASSWORD) {\n15:       throw new Error('Gmail requires GMAIL_USER and GMAIL_APP_PASSWORD env vars.');\n16:     }\n17:     return nodemailer.createTransport({\n18:       service: 'gmail',\n19:       auth: { user: process.env.GMAIL_USER, pass: process.env.GMAIL_APP_PASSWORD },\n20:     });\n21:   }\n22: \n23:   if (provider === 'resend') {\n24:     if (!process.env.RESEND_API_KEY) throw new Error('Resend requires RESEND_API_KEY env var.');\n25:     return nodemailer.createTransport({\n26:       host: 'smtp.resend.com', port: 465, secure: true,\n27:       auth: { user: 'resend', pass: process.env.RESEND_API_KEY },\n28:     });\n29:   }\n30: \n31:   if (process.env.SMTP_HOST) {\n32:     return nodemailer.createTransport({\n33:       host: process.env.SMTP_HOST,\n34:       port: parseInt(process.env.SMTP_PORT || '587', 10),\n35:       secure: process.env.SMTP_SECURE === 'true',\n36:       auth: { user: process.env.SMTP_USER, pass: process.env.SMTP_PASS },\n37:     });\n38:   }\n39: \n40:   // Fallback: Ethereal test account\n41:   const testAccount = await nodemailer.createTestAccount();\n42:   console.log('[EmailService] No SMTP credentials - using Ethereal test account.');\n43:   console.log(`[EmailService] Ethereal user: ${testAccount.user}`);\n44:   return nodemailer.createTransport({\n45:     host: 'smtp.ethereal.email', port: 587, secure: false,\n46:     auth: { user: testAccount.user, pass: testAccount.pass },\n47:   });\n48: }\n49: \n50: const FROM_ADDRESS = process.env.SMTP_FROM || process.env.GMAIL_USER || '\"HomeSphere\" <notifications@homesphere.app>';\n51: \n52: function buildEmailHtml({ userName, title, bodyHtml, ctaText = null, urgencyColor = '#0ea5e9' }) {\n53:   return `<!DOCTYPE html>\n54: <html lang=\"en\"><head><meta charset=\"UTF-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"/><title>${title}</title></head>\n55: <body style=\"margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\">\n56:   <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;padding:32px 16px;\">\n57:     <tr><td align=\"center\">\n58:       <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.07);\">\n59:         <tr>\n60:           <td style=\"background:linear-gradient(135deg,${urgencyColor} 0%,#6366f1 100%);padding:28px 36px;\">\n61:             <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n62:               <tr>\n63:                 <td><span style=\"display:inline-block;background:rgba(255,255,255,0.2);border-radiu