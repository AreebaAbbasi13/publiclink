{"step_index":459,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-03T15:45:06Z","content":"Created At: 2026-09-03T08:45:06-07:00\nCompleted At: 2026-09-03T08:45:06-07:00\nFile Path: `file:///C:/Users/HP/.gemini/antigravity/scratch/household-app/server/routes/budget.js`\nTotal Lines: 98\nTotal Bytes: 3565\nShowing lines 1 to 98\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const express = require('express');\n2: const db = require('../db/database');\n3: const { authMiddleware } = require('../middleware/auth');\n4: \n5: const router = express.Router();\n6: router.use(authMiddleware);\n7: \n8: // GET /api/budget\n9: router.get('/', (req, res) => {\n10:   const month = req.query.month || new Date().toISOString().slice(0, 7);\n11: \n12:   try {\n13:     const budgetRecord = db.prepare('SELECT * FROM budgets WHERE user_id = ? AND month_year = ?').get(req.user.id, month);\n14:     const monthlyLimit = budgetRecord ? budgetRecord.monthly_limit : 0;\n15: \n16:     const billsPaid = db.prepare(`\n17:       SELECT COALESCE(SUM(amount), 0) as total \n18:       FROM bills \n19:       WHERE user_id = ? AND status = 'Paid' AND (due_date LIKE ? OR payment_date LIKE ?)\n20:     `).get(req.user.id, `${month}%`, `${month}%`).total;\n21: \n22:     const dailyExpenses = db.prepare(`\n23:       SELECT COALESCE(SUM(amount), 0) as total \n24:       FROM expenses \n25:       WHERE user_id = ? AND expense_date LIKE ?\n26:     `).get(req.user.id, `${month}%`).total;\n27: \n28:     const pantrySpending = db.prepare(`\n29:       SELECT COALESCE(SUM(total_cost), 0) as total \n30:       FROM pantry_purchases \n31:       WHERE user_id = ? AND purchase_date LIKE ?\n32:     `).get(req.user.id, `${month}%`).total;\n33: \n34:     const totalSpent = billsPaid + dailyExpenses + pantrySpending;\n35:     const remainingMoney = monthlyLimit > 0 ? (monthlyLimit - totalSpent) : 0;\n36:     const spentPercentage = monthlyLimit > 0 ? (totalSpent / monthlyLimit) * 100 : 0;\n37: \n38:     const isBudgetRunningLow = monthlyLimit > 0 && spentPercentage >= 80 && spentPercentage < 100;\n39:     const isBudgetExceeded = monthlyLimit > 0 && totalSpent >= monthlyLimit;\n40: \n41:     const pieSlices = [\n42:       { label: 'Paid Bills', value: Number(billsPaid.toFixed(2)), color: '#3B82F6' },\n43:       { label: 'Daily Expenses', value: Number(dailyExpenses.toFixed(2)), color: '#10B981' },\n44:       { label: 'Pantry Purchases', value: Number(pantrySpending.toFixed(2)), color: '#F59E0B' }\n45:     ].filter(s => s.value > 0);\n46: \n47:     return res.json({\n48:       month,\n49:       monthlyBudget: Number(monthlyLimit.toFixed(2)),\n50:       totalSpent: Number(totalSpent.toFixed(2)),\n51:       remainingMoney: Number(remainingMoney.toFixed(2)),\n52:       spentPercentage: Number(spentPercentage.toFixed(1)),\n53:       breakdown: {\n54:         paidBills: Number(billsPaid.toFixed(2)),\n55:         dailyExpenses: Number(dailyExpenses.toFixed(2)),\n56:         pantrySpending: Number(pantrySpending.toFixed(2))\n57:       },\n58:       isBudgetRunningLow,\n59:       isBudgetExceeded,\n60:       pieSlices\n61:     });\n62:   } catch (err) {\n63:     console.error('Fetch budget error:', err);\n64:     return res.status(500).json({ error: 'Failed to calculate budget.' });\n65:   }\n66: });\n67: \n68: // POST /api/budget\n69: router.post('/', (req, res) => {\n70:   const { monthly_limit, month_year = new Date().toISOString().slice(0, 7) } = req.body;\n71: \n72:   if (monthly_limit === undefined || Number(monthly_limit) < 0) {\n73:     return res.status(400).json({ error: 'Valid positive monthly budget limit is required.' });\n74:   }\n75: \n76:   const limit = Number(monthly_limit);\n77: \n78:   try {\n79:     db.prepare(`\n80:       INSERT INTO budgets (user_id, monthly_limit, month_year, updated_at)\n81:       VALUES (?, ?, ?, datetime('now'))\n82:       ON CONFLICT(user_id, month_year) \n83:       DO UPDATE SET monthly_limit = excluded.monthly_limit, updated_at = datetime('now')\n84:     `).run(req.user.id, limit, month_year);\n85: \n86:     return res.json({\n87:       message: 'Monthly budget configured successfully.',\n88:       month_year,\n89:       monthly_limit: limit\n90:     });\n91:   } catch (err) {\n92:     console.error('Save budget error:', err);\n93:     return res.status(500).json({ error: 'Failed to set budget.' });\n94:   }\n95: });\n96: \n97: module.exports = router;\r\n98: \nThe above content shows the entire, complete file contents of the requested file.\n"}
