{"step_index":431,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-03T15:43:18Z","content":"Created At: 2026-09-03T08:43:18-07:00\nCompleted At: 2026-09-03T08:43:19-07:00\nFile Path: `file:///C:/Users/HP/.gemini/antigravity/scratch/household-app/server/services/emailScheduler.js`\nTotal Lines: 190\nTotal Bytes: 7573\nShowing lines 1 to 190\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * Email Scheduler — background job that evaluates all users and dispatches\n3:  * real emails for bill reminders, pantry low-stock alerts, and budget warnings.\n4:  *\n5:  * Called:\n6:  *  - At server startup\n7:  *  - Every REMINDER_INTERVAL_MINUTES (default 60 minutes)\n8:  *  - On-demand after ledger mutations via triggerUserEmailCheck(userId)\n9:  *\n10:  * Uses email_notifications table with UNIQUE(user_id, reminder_key) to\n11:  * ensure each reminder is sent exactly once per threshold window.\n12:  * Keys reset naturally when:\n13:  *  - Bill reminder keys change per day (bill-{id}-{daysLeft}d-{date})\n14:  *  - Budget keys reset monthly (budget-{userId}-{month}-{type})\n15:  *  - Pantry keys reset when item is restocked (pantry-{id}-low-{date})\n16:  */\n17: const db = require('../db/database');\n18: const { evaluateUserReminders } = require('./reminderEngine');\n19: const {\n20:   sendEmail,\n21:   composeBillReminderEmail,\n22:   composePantryAlertEmail,\n23:   composeBudgetAlertEmail,\n24: } = require('./emailService');\n25: \n26: const INTERVAL_MINUTES = parseInt(process.env.REMINDER_INTERVAL_MINUTES || '60', 10);\n27: \n28: async function processUserEmails(userId) {\n29:   try {\n30:     const user = db.prepare('SELECT id, name, email, currency FROM users WHERE id = ?').get(userId);\n31:     if (!user || !user.email) return;\n32: \n33:     const reminders = evaluateUserReminders(userId);\n34:     const currency = user.currency || 'Rs.';\n35:     const today = new Date().toISOString().slice(0, 10);\n36:     const month = new Date().toISOString().slice(0, 7);\n37: \n38:     // --- 1. Bill Reminders ---\n39:     const billReminders = reminders.filter(r => r.type === 'bill_reminder');\n40:     for (const reminder of billReminders) {\n41:       const bill = db.prepare('SELECT * FROM bills WHERE id = ?').get(reminder.billId);\n42:       if (!bill) continue;\n43: \n44:       const today2 = new Date();\n45:       const dueDateObj = new Date(bill.due_date + 'T23:59:59');\n46:       const diffMs = dueDateObj.getTime() - today2.getTime();\n47:       const diffHours = diffMs / (1000 * 60 * 60);\n48:       const diffDays = Math.ceil(diffHours / 24);\n49:       const isOverdue = diffMs < 0;\n50: \n51:       // Unique key includes date so reminders fire once per day per threshold\n52:       const reminderKey = `bill-${bill.id}-${reminder.level}-${today}`;\n53: \n54:       const alreadySent = db.prepare(\n55:         'SELECT id FROM email_notifications WHERE user_id = ? AND reminder_key = ?'\n56:       ).get(userId, reminderKey);\n57:       if (alreadySent) continue;\n58: \n59:       const { subject, html } = composeBillReminderEmail({\n60:         userName: user.name,\n61:         bill,\n62:         daysLeft: diffDays,\n63:         hoursLeft: !isOverdue ? diffHours : null,\n64:         isOverdue,\n65:         currency,\n66:       });\n67: \n68:       const result = await sendEmail({ to: user.email, subject, html });\n69:       if (result.success) {\n70:         db.prepare(\n71:           'INSERT OR IGNORE INTO email_notifications (user_id, reminder_key, email_to, subject) VALUES (?, ?, ?, ?)'\n72:         ).run(userId, reminderKey, user.email, subject);\n73:         console.log(`[Scheduler] Bill reminder sent to ${user.email}: ${subject}`);\n74:       }\n75:     }\n76: \n77:     // --- 2. Pantry Low-Stock Alerts (grouped into one email per run) ---\n78:     const pantryReminders = reminders.filter(r => r.type === 'pantry_low');\n79:     if (pantryReminders.length > 0) {\n80:       const reminderKey = `pantry-low-batch-${userId}-${today}`;\n81:       const alreadySent = db.prepare(\n82:         'SELECT id FROM email_notifications WHERE user_id = ? AND reminder_key = ?'\n83:       ).get(userId, reminderKey);\n84: \n85:       if (!alreadySent) {\n86:         const lowItems = pantryReminders.map(r => {\n87:           const item = db.prepare('SELECT * FROM pantry_items WHERE id = ?').get(r.itemId);\n88:           return item;\n89:         }).filter(Boolean);\n90: \n91:         if (lowItems.length > 0) {\n92:           const { subject, html } = composePantryAlertEmail({ userName: user.name, items: lowItems, currency });\n93:           const result = await sendEmail({ to: user.email, subject, html });\n94:           if (result.success) {\n95:             db.prepare(\n96:               'INSERT OR IGNORE INTO email_notifications (user_id, reminder_key, email_to, subject) VALUES (?, ?, ?, ?)'\n97:             ).run(userId, reminderKey, user.email, subject);\n98:             console.log(`[Scheduler] Pantry alert sent to ${user.email}: ${pantryReminders.length} items`);\n99:           }\n100:         }\n101:       }\n102:     }\n103: \n104:     // --- 3. Budget Alerts ---\n105:     const budgetReminder = reminders.find(r => r.type === 'saving_alert' || r.type === 'budget_alert');\n106:     if (budgetReminder) {\n107:       const budgetType = budgetReminder.type === 'saving_alert' ? 'exceeded' : 'low';\n108:       const reminderKey = `budget-${userId}-${month}-${budgetType}`;\n109:       const alreadySent = db.prepare(\n110:         'SELECT id FROM email_notifications WHERE user_id = ? AND reminder_key = ?'\n111:       ).get(userId, reminderKey);\n112: \n113:       if (!alreadySent) {\n114:         const budgetRecord = db.prepare(\n115:           'SELECT monthly_limit FROM budgets WHERE user_id = ? AND month_year = ?'\n116:         ).get(userId, month);\n117: \n118:         if (budgetRecord) {\n119:           // Calculate actuals\n120:           const billsPaid = db.prepare(\n121:             `SELECT COALESCE(SUM(amount), 0) as total FROM bills\n122:              WHERE user_id = ? AND status = 'Paid' AND (due_date LIKE ? OR payment_date LIKE ?)`\n123:           ).get(userId, `${month}%`, `${month}%`).total;\n124: \n125:           const expTotal = db.prepare(\n126:             `SELECT COALESCE(SUM(amount), 0) as total FROM expenses\n127:              WHERE user_id = ? AND expense_date LIKE ?`\n128:           ).get(userId, `${month}%`).total;\n129: \n130:           const pantryTotal = db.prepare(\n131:             `SELECT COALESCE(SUM(total_cost), 0) as total FROM pantry_purchases\n132:              WHERE user_id = ? AND purchase_date LIKE ?`\n133:           ).get(userId, `${month}%`).total;\n134: \n135:           const totalSpent = billsPaid + expTotal + pantryTotal;\n136:           const monthlyLimit = budgetRecord.monthly_limit;\n137:           const spentPct = (totalSpent / monthlyLimit) * 100;\n138: \n139:           const { subject, html } = composeBudgetAlertEmail({\n140:             userName: user.name,\n141:             totalSpent,\n142:             monthlyLimit,\n143:             spentPct,\n144:             currency,\n145:             month,\n146:           });\n147: \n148:           const result = await sendEmail({ to: user.email, subject, html });\n149:           if (result.success) {\n150:             db.prepare(\n151:               'INSERT OR IGNORE INTO email_notifications (user_id, reminder_key, email_to, subject) VALUES (?, ?, ?, ?)'\n152:             ).run(userId, reminderKey, user.email, subject);\n153:             console.log(`[Scheduler] Budget alert sent to ${user.email}: ${subject}`);\n154:           }\n155:         }\n156:       }\n157:     }\n158:   } catch (err) {\n159:     console.error(`[Scheduler] Error processing emails for user ${userId}:`, err.message);\n160:   }\n161: }\n162: \n163: async function runEmailCheckForAllUsers() {\n164:   try {\n165:     const users = db.prepare('SELECT id FROM users').all();\n166:     console.log(`[Scheduler] Running email check for ${users.length} user(s)...`);\n167:     for (const u of users) {\n168:       await processUserEmails(u.id);\n169:     }\n170:   } catch (err) {\n171:     console.error('[Scheduler] Error in email batch run:', err.message);\n172:   }\n173: }\n174: \n175: // Trigger email check for a specific user (called after ledger mutations)\n176: async function triggerUserEmailCheck(userId) {\n177:   setImmediate(() => processUserEmails(userId));\n178: }\n179: \n180: // Start background scheduler\n181: function startEmailScheduler() {\n182:   console.log(`[Scheduler] Email reminder scheduler started (interval: ${INTERVAL_MINUTES} min)`);\n183:   // Run once at startup after a short delay\n184:   setTimeout(runEmailCheckForAllUsers, 10000);\n185:   // Then repeat on interval\n186:   setInterval(runEmailCheckForAllUsers, INTERVAL_MINUTES * 60 * 1000);\n187: }\n188: \n189: module.exports = { startEmailScheduler, triggerUserEmailCheck, runEmailCheckForAllUsers };\r\n190: \nThe above content shows the entire, complete file contents of the requested file.\n"}
