m:20px;\">\n171:       <tr><td style=\"font-size:13px;color:#64748b;font-weight:600;\">Budget for ${month}</td></tr>\n172:       <tr><td>\n173:         <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:12px;\">\n174:           <tr>\n175:             <td style=\"font-size:12px;color:#64748b;\">Monthly Target</td>\n176:             <td style=\"font-size:14px;font-weight:800;color:#0f172a;text-align:right;\">${currency}${monthlyLimit.toFixed(2)}</td>\n177:           </tr>\n178:           <tr>\n179:             <td style=\"font-size:12px;color:#64748b;padding-top:6px;\">Total Spent</td>\n180:             <td style=\"font-size:14px;font-weight:800;color:${urgencyColor};text-align:right;padding-top:6px;\">${currency}${totalSpent.toFixed(2)}</td>\n181:           </tr>\n182:           <tr>\n183:             <td style=\"font-size:12px;color:#64748b;padding-top:6px;\">${isExceeded ? 'Overspend' : 'Remaining'}</td>\n184:             <td style=\"font-size:14px;font-weight:800;color:${isExceeded ? '#ef4444' : '#16a34a'};text-align:right;padding-top:6px;\">${currency}${Math.abs(remaining).toFixed(2)}</td>\n185:           </tr>\n186:         </table>\n187:       </td></tr>\n188:       <tr><td style=\"padding-top:16px;\">\n189:         <div style=\"background:#e2e8f0;border-radius:99px;height:8px;overflow:hidden;\">\n190:           <div style=\"background:${urgencyColor};width:${Math.min(100, spentPct).toFixed(0)}%;height:8px;border-radius:99px;\"></div>\n191:         </div>\n192:         <p style=\"margin:6px 0 0;font-size:12px;color:${urgencyColor};font-weight:700;\">${spentPct.toFixed(0)}% of budget used</p>\n193:       </td></tr>\n194:     </table>\n195:     <p style=\"margin:0;font-size:14px;color:#334155;line-height:1.7;\">\n196:       ${isExceeded\n197:         ? `You have exceeded your monthly budget by <strong>${currency}${Math.abs(remaining).toFixed(2)}</strong>. Review discretionary expenses to get back on track.`\n198:         : `You have used