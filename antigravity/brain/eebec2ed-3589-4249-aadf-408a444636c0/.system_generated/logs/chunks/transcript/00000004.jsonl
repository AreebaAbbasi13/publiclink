.createTransport({\n33:       host: process.env.SMTP_HOST,\n34:       port: parseInt(process.env.SMTP_PORT || '587', 10),\n35:       secure: process.env.SMTP_SECURE === 'true',\n36:       auth: {\n<truncated 10250 bytes>\nle=\"margin:0;font-size:14px;color:#334155;line-height:1.7;\">\n196:       ${isExceeded\n197:         ? `You have exceeded your monthly budget by <strong>${currency}${Math.abs(remaining).toFixed(2)}</strong>. Review discretionary expenses to get back on track.`\n198:         : `You have used ${spentPct.toFixed(0)}% of your budget. Only <strong>${currency}${remaining.toFixed(2)}</strong> remains for ${month}.`\n199:       }\n200:     </p>\n201:   `;\n202: \n203:   return {\n204:     subject: isExceeded\n205:       ? `Budget Exceeded: ${currency}${totalSpent.toFixed(2)} of ${currency}${monthlyLimit.toFixed(2)} spent`\n206:       : `Budget Alert: ${spentPct.toFixed(0)}% of your ${month} budget used`,\n207:     html: buildEmailHtml({ userName, title: isExceeded ? 'Monthly Budget Exceeded' : `Budget Running Low (${spentPct.toFixed(0)}%)`, bodyHtml, ctaText: 'View Budget Dashboard', urgencyColor }),\n208:   };\n209: }\n210: \n211: let _transporter = null;\n212: async function getTransporter() {\n213:   if (!_transporter) _transporter = await createTransporter();\n214:   return _transporter;\n215: }\n216: \n217: async function sendEmail({ to, subject, html }) {\n218:   try {\n219:     const transporter = await getTransporter();\n220:     const info = await transporter.sendMail({ from: FROM_ADDRESS, to, subject, html });\n221:     const previewUrl = nodemailer.getTestMessageUrl(info);\n222:     if (previewUrl) {\n223:       console.log(`[EmailService] Email preview (Ethereal): ${previewUrl}`);\n224:     } else {\n225:       console.log(`[EmailService] Email sent to ${to}: ${info.messageId}`);\n226:     }\n227:     return { success: true, messageId: info.messageId, previewUrl };\n228:   } catch (err) {\n229:     console.error(`[EmailService] Failed to send to ${to}:`, err.message);\n230:     return { success: false, error: err.message };\n231:   }\n232: }\n233: \n234: module.exports = { sendEmail, composeBillReminderEmail, composePantryAlertEmail, composeBudgetAlertEmail };\r\n235: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
