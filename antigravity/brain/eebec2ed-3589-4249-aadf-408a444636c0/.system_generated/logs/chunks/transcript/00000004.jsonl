sers, 10000);\n185:   // Then repeat on interval\n186:   setInterval(runEmailCheckForAllUsers, INTERVAL_MINUTES * 60 * 1000);\n187: }\n188: \n189: module.exports = { startEmailScheduler, triggerUserEmailCheck, runEmailCheckForAllUsers };\r\n190: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
