40:         bill.status = 'Overdue';\n41:       }\n42:       const daysOverdue = Math.abs(diffDays);\n43:       reminderLevel = 'overdue';\n44:       urgency = 'danger';\n45:       reminderTitle = `Overdue Bill: ${bi\n<truncated 4405 bytes>\ne LIKE ?)\n137:     `).get(userId, `${currentMonthYear}%`, `${currentMonthYear}%`).total;\n138: \n139:     const expensesTotal = db.prepare(`\n140:       SELECT COALESCE(SUM(amount), 0) as total \n141:       FROM expenses \n142:       WHERE user_id = ? AND expense_date LIKE ?\n143:     `).get(userId, `${currentMonthYear}%`).total;\n144: \n145:     const pantryTotal = db.prepare(`\n146:       SELECT COALESCE(SUM(total_cost), 0) as total \n147:       FROM pantry_purchases \n148:       WHERE user_id = ? AND purchase_date LIKE ?\n149:     `).get(userId, `${currentMonthYear}%`).total;\n150: \n151:     const totalSpent = billsPaid + expensesTotal + pantryTotal;\n152:     const spentPercentage = (totalSpent / monthlyLimit) * 100;\n153: \n154:     if (totalSpent >= monthlyLimit) {\n155:       reminders.push({\n156:         id: `budget-${currentMonthYear}-exceeded`,\n157:         type: 'saving_alert',\n158:         urgency: 'danger',\n159:         title: 'Saving Alert: Monthly Budget Exceeded',\n160:         message: `You have spent ${currency}${totalSpent.toFixed(2)}, exceeding your ${currency}${monthlyLimit.toFixed(2)} monthly budget by ${currency}${(totalSpent - monthlyLimit).toFixed(2)}. Consider reviewing discretionary expenses.`,\n161:         createdAt: new Date().toISOString()\n162:       });\n163:     } else if (spentPercentage >= 80) {\n164:       reminders.push({\n165:         id: `budget-${currentMonthYear}-low`,\n166:         type: 'budget_alert',\n167:         urgency: 'warning',\n168:         title: `Budget Running Low (${spentPercentage.toFixed(0)}% Used)`,\n169:         message: `You have spent ${currency}${totalSpent.toFixed(2)} of your ${currency}${monthlyLimit.toFixed(2)} budget. Only ${currency}${(monthlyLimit - tota