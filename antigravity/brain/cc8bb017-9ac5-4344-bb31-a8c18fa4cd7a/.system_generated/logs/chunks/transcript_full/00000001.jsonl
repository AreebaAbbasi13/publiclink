{"step_index":81,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-05T06:25:07Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"use client\"\n\nimport { useOrganization, useUser } from \"@clerk/nextjs\"\nimport { useMemo } from \"react\"\nimport type { PermissionKey } from \"@/lib/auth/permissions\"\nimport type { RoleDefinition } from \"@/lib/auth/roles\"\nimport { DEFAULT_ROLES } from \"@/lib/auth/roles\"\n\ninterface UsePermissionsReturn {\n  can: (permission: PermissionKey) => boolean\n  canAll: (...permissions: PermissionKey[]) => boolean\n  canAny: (...permissions: PermissionKey[]) => boolean\n  permissions: PermissionKey[]\n  role: RoleDefinition | null\n  isLoaded: boolean\n}\n\nexport function usePermissions(): UsePermissionsReturn {\n  const { user, isLoaded: userLoaded } = useUser()\n  const { organization, membership, isLoaded: orgLoaded } = useOrganization()\n\n  const isLoaded = userLoaded && orgLoaded\n\n  const { permissions, role } = useMemo(() => {\n    if (!isLoaded || !user) return { permissions: [] as PermissionKey[], role: null }\n\n    // Get custom roles from org metadata or use defaults\n    const orgMetadata = organization?.publicMetadata as { roles?: RoleDefinition[] } | undefined\n    const availableRoles: RoleDefinition[] = orgMetadata?.roles ?? DEFAULT_ROLES\n\n    // Get the user's role in the current org\n    const memberRole = membership?.role // e.g. \"org:admin\", \"org:manager\"\n    \n    if (!memberRole) {\n      // Check user's personal metadata for standalone permissions\n      const userMeta = user.publicMetadata as { role?: string; permissions?: PermissionKey[] }\n      if (userMeta?.permissions) {\n        return { permissions: userMeta.permissions, role: null }\n      }\n      return { permissions: [] as PermissionKey[], role: null }\n    }\n\n    // Map clerk role (org:admin) to our role system\n    const roleSlug = memberRole.replace(\"org:\", \"\")\n    const matchedRole = availableRoles.find(\n      (r) => r.id === roleSlug || r.id === memberRole || r.name.toLowerCase().replace(/\\s+/g, \"-\") === roleSlug\n    )\n\n    // Super admin / org:admin gets all permissions\n    if (roleSlug === \"admin\" || memberRole === \"org:admin\") {\n      const superAdmin = availableRoles.find((r) => r.id === \"super-admin\")\n      if (superAdmin) {\n        return { permissions: superAdmin.permissions, role: superAdmin }\n      }\n    }\n\n    return {\n      permissions: matchedRole?.permissions ?? [] as PermissionKey[],\n      role: matchedRole ?? null,\n    }\n  }, [isLoaded, user, organization, membership])\n\n  const can = useMemo(() => (permission: PermissionKey): boolean => {\n    return permissions.includes(permission)\n  }, [permissions])\n\n  const canAll = useMemo(() => (...perms: PermissionKey[]): boolean => {\n    return perms.every((p) => permissions.includes(p))\n  }, [permissions])\n\n  const canAny = useMemo(() => (...perms: PermissionKey[]): boolean => {\n    return perms.some((p) => permissions.includes(p))\n  }, [permissions])\n\n  return { can, canAll, canAny, permissions, role, isLoaded }\n}\n","Description":"Client-side permissions hook wrapping Clerk org membership","Overwrite":true,"TargetFile":"c:\\Users\\HP\\Desktop\\New folder\\src\\hooks\\use-permissions.ts","toolAction":"Writing permissions hook","toolSummary":"Client permissions hook"}}]}
