i) => (\n          <div key={i} className=\"flex items-center gap-3 p-3\">\n            <Skeleton className=\"h-8 w-8 rounded-full\" />\n            <div className=\"space-y-2 flex-1\">\n              <Skeleton className=\"h-4 w-32\" />\n              <Skeleton className=\"h-3 w-48\" />\n            </div>\n            <Skeleton className=\"h-6 w-16 rounded-full\" />\n          </div>\n        ))}\n      </div>\n    )\n  }\n\n  if (variant === \"detail\") {\n    return (\n      <div className={cn(\"space-y-6\", className)}>\n        <div className=\"flex items-center gap-4\">\n          <Skeleton className=\"h-16 w-16 rounded-full\" />\n          <div className=\"space-y-2\">\n            <Skeleton className=\"h-6 w-40\" />\n            <Skeleton className=\"h-4 w-56\" />\n          </div>\n        </div>\n        <div className=\"space-y-4\">\n          {Array.from({ length: 4 }).map((_, i) => (\n            <div key={i} className=\"space-y-2\">\n              <Skeleton className=\"h-4 w-24\" />\n              <Skeleton className=\"h-10 w-full\" />\n            </div>\n          ))}\n        </div>\n      </div>\n    )\n  }\n\n  // Table variant (default)\n  return (\n    <div className={cn(\"space-y-2\", className)}>\n      {/* Header */}\n      <div className=\"flex items-center gap-4 p-4 border-b border-border\">\n        {[80, 160, 120, 100, 80, 60].map((w, i) => (\n          <Skeleton key={i} className={`h-4 w-${w}`} style={{ width: w }} />\n        ))}\n      </div>\n      {/* Rows */}\n      {Array.from({ length: rows }).map((_, i) => (\n        <div key={i} className=\"flex items-center gap-4 px-4 py-3\">\n          <Skeleton className=\"h-4 w-4 rounded\" />\n          <Skeleton className=\"h-8 w-8 rounded-full\" />\n          <Skeleton className=\"h-4 w-32\" />\n          <Skeleton className=\"h-4 w-48\" />\n          <Skeleton className=\"h-5 w-16 rounded-full\" />\n          <Skeleton className=\"h-4 w-24\" />\n          <Skeleton className=\"h-4 w-20\" />\n          <Skeleton className=\"h-8 w-8 rounded ml-auto\" />\n        </div>\n      ))}\n    </div>\n  )\n}\n","Description":"Reusable loading skeleton component with multiple variants","Overwrite":true,"TargetFile":"c:\\Users\\HP\\Desktop\\New folder\\src\\components\\shared\\loading-skeleton.tsx","toolAction":"Writing loading skeleton","toolSummary":"Loading skeleton component"}}]}
