{"step_index":75,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-05T06:24:37Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import { auth } from \"@clerk/nextjs/server\"\nimport type { PermissionKey } from \"./permissions\"\nimport type { RoleDefinition } from \"./roles\"\nimport { DEFAULT_ROLES } from \"./roles\"\n\n/**\n * Client-safe: get permissions from the current org membership's public metadata.\n * This runs on the server; for client use the usePermissions hook.\n */\nexport async function getServerPermissions(): Promise<PermissionKey[]> {\n  const { sessionClaims, orgId } = await auth()\n  if (!orgId || !sessionClaims) return []\n\n  // Clerk stores org membership metadata in sessionClaims.org_metadata\n  const orgRole = (sessionClaims as Record<string, unknown>)[\"org_role\"] as string | undefined\n  const orgMetadata = (sessionClaims as Record<string, unknown>)[\"org_metadata\"] as Record<string, unknown> | undefined\n\n  // Try to get custom roles from org metadata\n  const customRoles = orgMetadata?.[\"roles\"] as RoleDefinition[] | undefined\n  const roles = customRoles || DEFAULT_ROLES\n\n  if (!orgRole) return []\n\n  // Find the role that matches the org role\n  const role = roles.find((r) => r.id === orgRole || r.name.toLowerCase().replace(/\\s+/g, \"-\") === orgRole?.replace(\"org:\", \"\"))\n  return role?.permissions ?? []\n}\n\n/**\n * Server-side permission check. Throws an error if the user doesn't have the permission.\n * Use this in Server Actions and API Route Handlers.\n */\nexport async function requirePermission(permission: PermissionKey): Promise<void> {\n  const { userId, orgId } = await auth()\n\n  if (!userId) {\n    throw new Error(\"UNAUTHORIZED: Not authenticated\")\n  }\n\n  const permissions = await getServerPermissions()\n\n  if (!permissions.includes(permission)) {\n    throw new Error(`FORBIDDEN: Missing permission: ${permission}`)\n  }\n}\n\n/**\n * Server-side multi-permission check. All permissions must be present.\n */\nexport async function requireAllPermissions(...permissions: PermissionKey[]): Promise<void> {\n  const userPermissions = await getServerPermissions()\n  for (const perm of permissions) {\n    if (!userPermissions.includes(perm)) {\n      throw new Error(`FORBIDDEN: Missing permission: ${perm}`)\n    }\n  }\n}\n\n/**\n * Server-side: check if user has a permission (returns boolean, doesn't throw).\n */\nexport async function hasPermission(permission: PermissionKey): Promise<boolean> {\n  try {\n    const permissions = await getServerPermissions()\n    return permissions.includes(permission)\n  } catch {\n    return false\n  }\n}\n","Description":"Server-side authorization helpers with requirePermission guard","Overwrite":true,"TargetFile":"c:\\Users\\HP\\Desktop\\New folder\\src\\lib\\auth\\server.ts","toolAction":"Writing server auth helpers","toolSummary":"Server authorization library"}}]}
